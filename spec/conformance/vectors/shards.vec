# Shard-assignment parity (spec §8.1, §11.1.3): shard_index(ue_id, n_shards=8).
config n_shards=8 queue_capacity=1024 max_contexts_per_shard=200000

shard 1        => 5
shard 2        => 2
shard 3        => 0
shard 7        => 4
shard 42       => 2
shard 1001     => 3
shard 2002     => 7
shard 1000001  => 4
shard 5000000  => 6
shard 9999999  => 3
