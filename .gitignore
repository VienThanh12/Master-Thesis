# LaTeX build artifacts. .latexmkrc sends these to build/, but the extension
# patterns stay: an editor or a manual pdflatex run can still drop them beside
# the sources.
build/
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
*.idx
*.ilg
*.ind
*.nls
*.nlo
*.run.xml
*.bcf
*.dvi
*.xdv

# C++ build
cpp/build/

# Python bytecode
__pycache__/
*.pyc

# Rust build
rust/target/
target/

# C++ jemalloc variant build + benchmark artifacts
cpp/build-jemalloc/
# Heap-profiling variant: links a prof-enabled jemalloc, attribution only, never
# the arm the campaign measures (bench/alloc_profile.sh).
cpp/build-jemalloc-prof/
bench/.bin/
bench/results/

# Container build trees and smoke-run outputs. The container builds into its own
# directories on purpose (a CMake cache records its compiler's absolute path, so
# sharing cpp/build with the host makes CMake refuse once the toolset compiler
# appears), and docker/run.sh --smoke sends results here so a test run cannot
# become the newest campaign in bench/results.
docker/.scratch/

# Fault-injection built binaries (taxonomy.md/.csv are kept; *.log matched above).
# .miri is the throwaway package run_miri.sh generates so Miri has something to
# build; the case sources it points at live in faults/rust/.
faults/results/.bin/
faults/results/.miri/

# FFI prototype build artifacts (Rust target dir covered by target/ above)
ffi/host
ffi/**/target/

# Editor/OS
.DS_Store
*.swp
*~
.vscode/

# Rendered PDF page images (workaround for broken WSL webview preview)
.pdf-preview/

# Slide-deck tooling
.venv-pptx/
.cursor/skills/create-pptx-master-thesis/
Rust_vs_Cpp_Nokia_RAN_thesis.pptx
# figures/*.pdf rasterised for the deck; rebuilt from the tracked source plots
.deck-assets/
