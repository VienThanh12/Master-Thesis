# LaTeX build artifacts. .latexmkrc sends these to build/, but the extension
# patterns stay: an editor or a manual pdflatex run can still drop them beside
# the sources.
build/
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
*.idx
*.ilg
*.ind
*.nls
*.nlo
*.run.xml
*.bcf
*.dvi
*.xdv

# C++ build
cpp/build/

# Python bytecode
__pycache__/
*.pyc

# Rust build
rust/target/
target/

# C++ jemalloc variant build + benchmark artifacts
cpp/build-jemalloc/
bench/.bin/
bench/results/

# Fault-injection built binaries (taxonomy.md/.csv are kept; *.log matched above)
faults/results/.bin/

# FFI prototype build artifacts (Rust target dir covered by target/ above)
ffi/host
ffi/**/target/

# Editor/OS
.DS_Store
*.swp
*~
.vscode/

# Rendered PDF page images (workaround for broken WSL webview preview)
.pdf-preview/

# Slide-deck tooling
.venv-pptx/
.cursor/skills/create-pptx-master-thesis/
Rust_vs_Cpp_Nokia_RAN_thesis.pptx
# figures/*.pdf rasterised for the deck; rebuilt from the tracked source plots
.deck-assets/
