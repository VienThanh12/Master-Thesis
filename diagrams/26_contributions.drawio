      <mxGeometry x="15" y="396" width="850" height="78" as="geometry"/>
    </mxCell>
    <mxCell id="n57" value="Where it goes next" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="31" y="406.12" width="122.63" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n58" value="the bare-metal campaign first. What bare metal now buys is the tail and the overload cliff, not the repeat count." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="206" y="408.02" width="646.64" height="15.75" as="geometry"/>
    </mxCell>
