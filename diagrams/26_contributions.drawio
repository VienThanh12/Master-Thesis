    </mxCell>
    <mxCell id="n55" value="A catalogue of what the guarantee misses" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d7dde3;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
