    <mxCell id="n55" value="a same-host repeat of in-run and deferred fill, so the recorder can be separated from the machine." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
