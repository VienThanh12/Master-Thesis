<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="524" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="What the thesis concludes, and what it leaves behind" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="128.26" y="11.1" width="623.48" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="The evidence divides by what is being measured before it divides by resource" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="181.12" y="42.12" width="517.75" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n16" value="&lt;b&gt;Safety: a difference in kind&lt;/b&gt;&lt;br&gt;&lt;br&gt;Safe Rust rejects all five injected&lt;br&gt;memory-safety and data-race classes at&lt;br&gt;compile time. The two boundary classes&lt;br&gt;(a lock-order deadlock and a lost&lt;br&gt;update) compile and misbehave&lt;br&gt;exactly as they do in C++.&lt;br&gt;&lt;br&gt;Rust eliminates data races, not race&lt;br&gt;conditions, and aliasing errors, not&lt;br&gt;lock-ordering errors." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=11;spacingTop=5;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="15" y="76" width="278" height="218" as="geometry"/>
    </mxCell>
    <mxCell id="n28" value="&lt;b&gt;Migration: the cost is human&lt;/b&gt;&lt;br&gt;&lt;br&gt;An unmodified Rust core can be driven&lt;br&gt;from C++ across a thin seam that&lt;br&gt;concentrates every unsafe site, for a&lt;br&gt;cost on a real operation bounded at&lt;br&gt;10.91% against the same operation&lt;br&gt;called natively.&lt;br&gt;&lt;br&gt;What migration costs is API design and&lt;br&gt;the learning curve, not run time." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=11;spacingTop=5;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="301" y="76" width="278" height="218" as="geometry"/>
    </mxCell>
    <mxCell id="n41" value="&lt;b&gt;Performance: two different answers&lt;/b&gt;&lt;br&gt;&lt;br&gt;End to end, an operation is 0.250% the&lt;br&gt;work the language performs and the rest&lt;br&gt;a cross-thread handoff. The two are&lt;br&gt;equivalent at the median and&lt;br&gt;unresolvable at the tail.&lt;br&gt;&lt;br&gt;Measured on the operation alone they&lt;br&gt;are not equivalent: Rust is faster by&lt;br&gt;about a factor of two, for reasons&lt;br&gt;tracing to hash-map layout." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=11;spacingTop=5;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="587" y="76" width="278" height="218" as="geometry"/>
    </mxCell>
    <mxCell id="n42" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f1f4f7;strokeColor=#d7dde3;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="15" y="308" width="850" height="74" as="geometry"/>
    </mxCell>
    <mxCell id="n43" value="What this adds to the decision is an instrument, not a verdict" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="31" y="318.12" width="422.38" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n46" value="A frozen specification" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d7dde3;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="31" y="344" width="156.2" height="26" as="geometry"/>
    </mxCell>
    <mxCell id="n49" value="A parity-tested pair" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d7dde3;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="197.2" y="344" width="144.0" height="26" as="geometry"/>
    </mxCell>
    <mxCell id="n52" value="A reproducible framework" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d7dde3;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
