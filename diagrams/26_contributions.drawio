    <mxCell id="n70" value="Extend the catalogue" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bcd0e8;align=center;verticalAlign=middle;fontSize=10;fontColor=#1c4e86;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="430.0" y="434" width="140.0" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="n73" value="Async runtimes" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bcd0e8;align=center;verticalAlign=middle;fontSize=10;fontColor=#1c4e86;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="579.0" y="434" width="104.0" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="n76" value="Isolate the heaps" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bcd0e8;align=center;verticalAlign=middle;fontSize=10;fontColor=#1c4e86;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="692.0" y="434" width="122.0" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="n77" value="For stateful, concurrent, partitionable control-plane services of this kind, the choice between modern C++ and Rust is not a performance decision." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="-17.53" y="491.07" width="915.06" height="17.25" as="geometry"/>
    </mxCell>
