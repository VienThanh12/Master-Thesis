    </mxCell>
    <mxCell id="n59" value="&lt;b&gt;Control parameters&lt;/b&gt;&lt;br&gt;&lt;br&gt;5 000 active UEs, and 14 offered-load levels up to&lt;br&gt;784 kops/s swept from nominal through saturation into&lt;br&gt;overload. Open loop against a fixed intended send&lt;br&gt;schedule, so latency is measured from the time an&lt;br&gt;operation should have been sent rather than was." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f1f4f7;strokeColor=#d7dde3;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=11;spacingTop=5;spacingRight=6;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="20" y="328" width="410" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="n67" value="&lt;b&gt;Why the draw order is pinned&lt;/b&gt;&lt;br&gt;&lt;br&gt;A fixed SplitMix64 draw order means that for a given&lt;br&gt;seed and active-UE population the two implementations&lt;br&gt;emit exactly the same count of each operation kind. A&lt;br&gt;divergence is therefore a parity failure rather than a&lt;br&gt;difference in what the two were asked to do." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=11;spacingTop=5;spacingRight=6;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="450" y="328" width="410" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="n68" value="The workload is synthetic and specification-justified rather than replayed from production traffic, so its operation mix is plausible rather than validated." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="-48.87" y="457.07" width="977.73" height="17.25" as="geometry"/>
    </mxCell>
