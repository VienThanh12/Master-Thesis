    <mxCell id="n2" value="The two workloads, and the lifecycle the mixed one walks" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="104.28" y="11.1" width="671.44" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="A fixed draw order makes the per-operation-kind counts identical in both languages, so the workload doubles as a parity signal" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="10.81" y="42.12" width="858.38" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="&lt;b&gt;signal — the steady-state hot path&lt;/b&gt;&lt;br&gt;&lt;br&gt;Preloads a population of connected UEs and then hammers&lt;br&gt;handle_signaling, isolating per-message latency with no&lt;br&gt;lifecycle transitions in the way." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=11;spacingTop=5;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="20" y="78" width="410" height="106" as="geometry"/>
    </mxCell>
    <mxCell id="n15" value="&lt;b&gt;mixed — the full RAN lifecycle&lt;/b&gt;&lt;br&gt;&lt;br&gt;A pinned generator that walks each UE through a realistic&lt;br&gt;procedure sequence, using a per-slot expected-state model&lt;br&gt;so that every operation it emits is valid for that UE." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=11;spacingTop=5;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="450" y="78" width="410" height="106" as="geometry"/>
    </mxCell>
    <mxCell id="n16" value="The procedure sequence the mixed workload walks, per UE" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
