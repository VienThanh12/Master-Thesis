    <mxCell id="n51" value="resulting state" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=9.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
