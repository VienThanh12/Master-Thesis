    <mxCell id="n145" value="The gap" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="28" y="633.0" width="76.3" height="30.0" as="geometry"/>
    </mxCell>
    <mxCell id="n146" value="most of the telecom studies change two things at once:" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="136" y="634.9" width="529.74" height="27.0" as="geometry"/>
    </mxCell>
    <mxCell id="n147" value="the language, and how the program is run." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="136" y="656.9" width="402.21" height="27.0" as="geometry"/>
    </mxCell>
    <mxCell id="n148" value="Emberg and Wadsten keep the design the same," style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="136" y="678.9" width="431.64" height="27.0" as="geometry"/>
    </mxCell>
    <mxCell id="n149" value="but they still test a stateless program." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="136" y="700.9" width="392.4" height="27.0" as="geometry"/>
    </mxCell>
    <mxCell id="n150" value="None holds the concurrency model fixed" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="136" y="722.9" width="372.78" height="27.0" as="geometry"/>
    </mxCell>
    <mxCell id="n151" value="and then drives a stateful subsystem past saturation." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
