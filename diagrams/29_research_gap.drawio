    <mxCell id="n140" value="✗" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbdedb;strokeColor=none;align=center;verticalAlign=middle;fontSize=20;fontColor=#8c2a20;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
