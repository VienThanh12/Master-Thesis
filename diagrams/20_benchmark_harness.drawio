<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="505" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="How a reported number is produced" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="242.16" y="11.1" width="395.67" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="From the frozen specification to the macro the prose cites, with no hand-copied value anywhere on the path" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="78.94" y="42.12" width="722.13" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n11" value="&lt;b&gt;Frozen specification&lt;/b&gt;&lt;br&gt;&lt;br&gt;spec/SPECIFICATION.md fixes&lt;br&gt;the API, state machine, data&lt;br&gt;structures, and concurrency&lt;br&gt;model, before any code is&lt;br&gt;written." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="15" y="76" width="200" height="126" as="geometry"/>
    </mxCell>
    <mxCell id="n19" value="&lt;b&gt;Four build variants&lt;/b&gt;&lt;br&gt;&lt;br&gt;Two languages crossed with&lt;br&gt;two allocators. Matched&lt;br&gt;optimisation levels; both&lt;br&gt;sides pin the same shard&lt;br&gt;and intra-shard hashes." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="231" y="76" width="200" height="126" as="geometry"/>
    </mxCell>
    <mxCell id="n27" value="&lt;b&gt;Deterministic driver&lt;/b&gt;&lt;br&gt;&lt;br&gt;A fixed SplitMix64 draw&lt;br&gt;order and a per-slot&lt;br&gt;expected-state model, so&lt;br&gt;both versions walk identical&lt;br&gt;code paths." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="447" y="76" width="200" height="126" as="geometry"/>
    </mxCell>
    <mxCell id="n35" value="&lt;b&gt;Service and capture&lt;/b&gt;&lt;br&gt;&lt;br&gt;Eight shards, one owning&lt;br&gt;thread each, 1024-slot&lt;br&gt;queues. HDR histogram&lt;br&gt;timed from the intended&lt;br&gt;send time, not the actual." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="663" y="76" width="200" height="126" as="geometry"/>
    </mxCell>
    <mxCell id="n36" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="217" y="139" as="sourcePoint"/>
        <mxPoint x="229" y="139" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n37" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="433" y="139" as="sourcePoint"/>
