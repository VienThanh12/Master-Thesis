    <mxCell id="n73" value="Nothing in the evaluation is hand-copied" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#1f6b41;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="31" y="413.12" width="272.5" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n74" value="bench/refresh_thesis.sh reruns the analysis and rebuilds the PDF, so a fresh campaign updates every figure, table, and quoted number in one step." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="31" y="433.55" width="869.27" height="16.5" as="geometry"/>
    </mxCell>
    <mxCell id="n75" value="A third party can walk this path without proprietary code: the specification and the harness are themselves published artifacts." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="38.88" y="475.07" width="802.24" height="17.25" as="geometry"/>
