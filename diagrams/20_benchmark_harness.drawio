    <mxCell id="n39" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#dce8f7;strokeColor=#bcd0e8;strokeWidth=1.0;" vertex="1" parent="1">
      <mxGeometry x="15" y="214" width="848" height="54" as="geometry"/>
    </mxCell>
    <mxCell id="n40" value="Repeated 15 times, with the four variants interleaved inside each repeat" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="31" y="224.6" width="470.88" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n41" value="8 offered-load levels up to 64 kops/s give 480 measured runs; interleaving makes the interference common to a block, so it cancels." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="31" y="244.55" width="785.35" height="16.5" as="geometry"/>
    </mxCell>
    <mxCell id="n48" value="&lt;b&gt;Raw measurement logs&lt;/b&gt;&lt;br&gt;&lt;br&gt;bench/results/*.jsonl, with&lt;br&gt;the environment record&lt;br&gt;from capture_env.sh kept&lt;br&gt;alongside each result set." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="15" y="284" width="196" height="104" as="geometry"/>
    </mxCell>
    <mxCell id="n55" value="&lt;b&gt;bench/plot_figures.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;Median with a bootstrap 95%&lt;br&gt;confidence interval, an exact&lt;br&gt;paired permutation test, and&lt;br&gt;the Holm correction." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="232" y="284" width="222" height="104" as="geometry"/>
    </mxCell>
    <mxCell id="n61" value="&lt;b&gt;Generated artifacts&lt;/b&gt;&lt;br&gt;&lt;br&gt;figures/*.pdf&lt;br&gt;figures/tab_*.tex&lt;br&gt;figures/gen_macros.tex" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="474" y="284" width="178" height="104" as="geometry"/>
    </mxCell>
    <mxCell id="n68" value="&lt;b&gt;thesis.tex&lt;/b&gt;&lt;br&gt;&lt;br&gt;The prose refers to&lt;br&gt;the generated macros&lt;br&gt;by name, so text and&lt;br&gt;data cannot drift." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="672" y="284" width="186" height="104" as="geometry"/>
    </mxCell>
