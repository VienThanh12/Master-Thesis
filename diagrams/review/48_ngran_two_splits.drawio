    </mxCell>
    <mxCell id="n21" value="&lt;b&gt;gNB-CU-UP&lt;/b&gt;&lt;br&gt;&lt;br&gt;User-plane forwarding. Not measured." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#f4fbf6;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
