    <mxCell id="n54" value="The RQ2 result is not a licence to describe a moved part as safe. The seam double-free is the in-guarantee class returning inside unsafe." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="408.6" width="895.98" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n55" value="Guideline 2 keeps the C ABI in its own crate so unsafe does not spread through crate chains. It does not sandbox the host." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="426.6" width="797.88" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n56" value="Per-call tax bounded at 10.91% of a real signal call. A do-nothing crossing bounds only itself." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
