      </mxGeometry>
    </mxCell>
    <mxCell id="n42" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="16" y="300" width="332" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="n43" value="Timed apart: the core" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f6b41;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="311.65" width="148.79" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n44" value="Shard map only. No queue." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="336.6" width="163.5" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n45" value="Rust is 1.6x faster." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="354.6" width="130.8" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n46" value="0.250% of the round-trip." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="372.6" width="163.5" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n47" value="Likely hash-map layout." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="390.6" width="150.42" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n48" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="364" y="300" width="500" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="n49" value="Timed together: the round-trip" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#a5700c;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="380" y="311.65" width="212.55" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n50" value="Producer to queue to worker to map to reply." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="380" y="336.6" width="287.76" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n51" value="Paired median gap 1.3 us. Real, too small to attribute." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="380" y="354.6" width="359.7" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n52" value="The rest is operating-system handoff." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="380" y="372.6" width="241.98" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n53" value="That clock answers a vendor sizing a node, not a language comparison." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="380" y="390.6" width="451.26" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n54" value="The only shared mutable state either version allows is one atomic counter. No control flow depends on its value." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="89.02" y="485.07" width="701.96" height="17.25" as="geometry"/>
    </mxCell>
