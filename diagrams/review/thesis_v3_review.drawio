      <mxGeometry x="20" y="182" width="72" height="44" as="geometry"/>
    </mxCell>
    <mxCell id="n24" value="&lt;b&gt;Methodology&lt;/b&gt;&lt;br&gt;&lt;br&gt;UECM, three methods, fairness, statistics, artefacts" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#d7dde3;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
