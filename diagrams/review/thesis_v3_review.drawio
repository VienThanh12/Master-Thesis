    </mxCell>
    <mxCell id="n45" value="&lt;b&gt;Discussion&lt;/b&gt;&lt;br&gt;&lt;br&gt;RQ answers, hypothesis verdicts, guidelines, what it cannot support" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#d7dde3;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
