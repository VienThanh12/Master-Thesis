    </mxCell>
    <mxCell id="n38" value="&lt;b&gt;Evaluation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hosts, two workloads, then results by load and by question" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#d7dde3;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
