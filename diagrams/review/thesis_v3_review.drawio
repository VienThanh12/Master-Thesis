      <mxGeometry x="236.17" y="11.1" width="407.66" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="Chapter 1 is the draft introduction. Chapters 2 to 7 keep five argument paragraphs each." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
