      <mxGeometry x="20" y="390" width="72" height="44" as="geometry"/>
    </mxCell>
    <mxCell id="n52" value="&lt;b&gt;Conclusion&lt;/b&gt;&lt;br&gt;&lt;br&gt;Narrow claim, then named next experiments" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#d7dde3;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="104" y="390" width="756" height="44" as="geometry"/>
    </mxCell>
    <mxCell id="n53" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.7;" vertex="1" parent="1">
      <mxGeometry x="20" y="446" width="840" height="92" as="geometry"/>
    </mxCell>
    <mxCell id="n54" value="This pack is for review, not for the PDF yet" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="36" y="457.65" width="311.74" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n55" value="Each later page unpacks one move the skeleton has to make in five paragraphs. Open the combined .drawio and step the tabs." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="479.07" width="764.63" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n56" value="Nothing here is cited by Thesis_v3.tex. Pick a page, then we can shrink it to a thesis figure if it earns a caption." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="495.07" width="727.03" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n57" value="Green in later pages marks a compiler or source fact. Amber marks a host-sensitive measurement. Red marks a refusal or a boundary." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32.61" y="587.08" width="814.77" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="31_three_trends" name="Three trends">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="600" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="Three trends that make the language choice timely" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="146.25" y="11.1" width="587.51" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="They meet in gNB-CU-CP UE-context work, which this study models as UECM" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="198.16" y="42.12" width="483.69" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n15" value="&lt;b&gt;1.  Cloud-native RAN&lt;/b&gt;&lt;br&gt;&lt;br&gt;Control-plane functions now run on&lt;br&gt;ordinary servers. Open-RAN turns the&lt;br&gt;base station into virtualised,&lt;br&gt;multi-vendor software on open&lt;br&gt;interfaces.&lt;br&gt;&lt;br&gt;A latency spike or a memory defect is&lt;br&gt;then a network-wide risk, not a local&lt;br&gt;fault on purpose-built hardware." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="20" y="76" width="266" height="268" as="geometry"/>
    </mxCell>
    <mxCell id="n27" value="&lt;b&gt;2.  AI as a neighbour&lt;/b&gt;&lt;br&gt;&lt;br&gt;IMT-2030 lists AI as a usage scenario,&lt;br&gt;not only as a tuner. AI-RAN puts radio&lt;br&gt;work and inference on one accelerated&lt;br&gt;server.&lt;br&gt;&lt;br&gt;The control plane no longer has&lt;br&gt;the host to itself. When the&lt;br&gt;neighbour takes capacity,&lt;br&gt;saturation arrives sooner." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="307" y="76" width="266" height="268" as="geometry"/>
    </mxCell>
    <mxCell id="n38" value="&lt;b&gt;3.  Memory-safe languages&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vendors report that most serious&lt;br&gt;bugs are memory-safety errors.&lt;br&gt;Agencies urge a move away from&lt;br&gt;C and C++. The EU Cyber Resilience&lt;br&gt;Act adds duties from 2026 and 2027.&lt;br&gt;&lt;br&gt;The Act names no language. Direct&lt;br&gt;RAN evidence is still missing." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="594" y="76" width="266" height="268" as="geometry"/>
    </mxCell>
    <mxCell id="n39" value="" style="html=1;rounded=0;strokeColor=#12233a;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="286" y="210" as="sourcePoint"/>
        <mxPoint x="300" y="210" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n40" value="" style="html=1;rounded=0;strokeColor=#12233a;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="573" y="210" as="sourcePoint"/>
        <mxPoint x="587" y="210" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n41" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f1f4f7;strokeColor=#d7dde3;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="20" y="362" width="840" height="168" as="geometry"/>
    </mxCell>
    <mxCell id="n42" value="Where they land in this thesis" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="36" y="373.65" width="212.55" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n49" value="&lt;b&gt;Industrial setting&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nokia is an end-to-end RAN vendor.&lt;br&gt;UECM models gNB-CU-CP per-UE state&lt;br&gt;work. It is specified in public.&lt;br&gt;No proprietary source is copied." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="404" width="250" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="n56" value="&lt;b&gt;A generational horizon&lt;/b&gt;&lt;br&gt;&lt;br&gt;3GPP Release 20 and 21 cover 6G&lt;br&gt;studies and normative work. A control&lt;br&gt;plane written now is maintained next&lt;br&gt;to that generation, not retired." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="304" y="404" width="250" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="n63" value="&lt;b&gt;A concrete failure mode&lt;/b&gt;&lt;br&gt;&lt;br&gt;A mobility storm frees a UE context&lt;br&gt;while an in-flight message still refers&lt;br&gt;to it. C++ compiles. Safe Rust rejects&lt;br&gt;the dangling reference." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="572" y="404" width="268" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="n64" value="The study measures both safety (which defects are prevented, and when) and predictability (tail latency under overload)." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="63.95" y="557.08" width="752.1" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="32_problem_rqs_hs" name="Problem, RQs, hypotheses">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="640" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="The problem, the four questions, and the three hypotheses" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="98.28" y="11.1" width="683.43" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="Hypotheses were written down before any measurement. Chapter 6 says how each one came out." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="133.44" y="42.12" width="613.13" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n8" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="16" y="72" width="848" height="118" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="THE OPEN PROBLEM" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#a5281b;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="72" width="848" height="32" as="geometry"/>
    </mxCell>
    <mxCell id="n10" value="Vendors are under technical and regulatory pressure to adopt memory-safe languages, yet they lack a direct, controlled test of a" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="108.6" width="837.12" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n11" value="stateful, concurrent RAN control-plane part. Average-throughput comparisons leave three dimensions open." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="124.6" width="680.16" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n14" value="Tail latency under overload" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b3ad;align=center;verticalAlign=middle;fontSize=11;fontColor=#8c2a20;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="154" width="220" height="26" as="geometry"/>
    </mxCell>
    <mxCell id="n15" value="" style="html=1;rounded=0;strokeColor=#8c2a20;strokeWidth=1.6;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="254" y="167.0" as="sourcePoint"/>
        <mxPoint x="264" y="167.0" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n18" value="Defects stopped at compile time" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b3ad;align=center;verticalAlign=middle;fontSize=11;fontColor=#8c2a20;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="266" y="154" width="236" height="26" as="geometry"/>
    </mxCell>
    <mxCell id="n19" value="" style="html=1;rounded=0;strokeColor=#8c2a20;strokeWidth=1.6;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="504" y="167.0" as="sourcePoint"/>
        <mxPoint x="514" y="167.0" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n22" value="Incremental adoption cost" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e6b3ad;align=center;verticalAlign=middle;fontSize=11;fontColor=#8c2a20;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="516" y="154" width="210" height="26" as="geometry"/>
    </mxCell>
    <mxCell id="n23" value="RESEARCH QUESTIONS" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#8794a3;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="16" y="197.55" width="107.91" height="16.5" as="geometry"/>
    </mxCell>
    <mxCell id="n26" value="RQ1" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dce8f7;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="16" y="218" width="64" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n31" value="&lt;b&gt;Latency predictability&lt;/b&gt;&lt;br&gt;&lt;br&gt;Median, p99, p99.9, p99.99 and the maximum, from&lt;br&gt;light load through overload." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="90" y="218" width="370" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n34" value="RQ2" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dce8f7;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="16" y="278" width="64" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n39" value="&lt;b&gt;Defect scope&lt;/b&gt;&lt;br&gt;&lt;br&gt;7 classes inside the guarantee, 7 on the&lt;br&gt;boundary. When is each caught, and at what cost." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="90" y="278" width="370" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n42" value="RQ3" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dce8f7;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="16" y="338" width="64" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n47" value="&lt;b&gt;Safety-model overhead&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bounds checks, copies, abstraction cost:&lt;br&gt;throughput, CPU, and peak RSS." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="90" y="338" width="370" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n50" value="RQ4" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dce8f7;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="16" y="398" width="64" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n55" value="&lt;b&gt;Incremental adoption&lt;/b&gt;&lt;br&gt;&lt;br&gt;Effort, FFI interoperability, and risk of adding&lt;br&gt;Rust a piece at a time." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="90" y="398" width="370" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n61" value="&lt;b&gt;H1  Performance below saturation&lt;/b&gt;&lt;br&gt;&lt;br&gt;The two languages are performance-equivalent&lt;br&gt;below saturation, with any difference only in&lt;br&gt;the far tail." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="218" width="384" height="84" as="geometry"/>
    </mxCell>
    <mxCell id="n67" value="&lt;b&gt;H2  Compile-time prevention&lt;/b&gt;&lt;br&gt;&lt;br&gt;Safe Rust prevents at compile time the memory-&lt;br&gt;safety and concurrency classes that C++ only&lt;br&gt;tries to catch after the program is built." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="312" width="384" height="84" as="geometry"/>
    </mxCell>
    <mxCell id="n73" value="&lt;b&gt;H3  Interop cost is not run time&lt;/b&gt;&lt;br&gt;&lt;br&gt;The extra time when C++ calls into Rust is&lt;br&gt;small next to the operations themselves. The&lt;br&gt;real cost is engineering work, not speed." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="406" width="384" height="84" as="geometry"/>
    </mxCell>
    <mxCell id="n74" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f1f4f7;strokeColor=#d7dde3;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="16" y="512" width="848" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n75" value="How RQ2 stays falsifiable" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="524.12" width="170.31" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n76" value="The catalogue is two-sided on purpose: 7 classes safe Rust is expected to prevent, and 7 it is expected not to." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="545.08" width="695.69" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n77" value="A previous study mapped CWE types onto a list. This one builds and runs a program for each class." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="561.08" width="607.95" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n78" value="H1 does double duty for RQ1 and RQ3. Chapter 6 finds that wording to be the hypothesis's main weakness." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="117.22" y="609.08" width="645.55" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="33_three_methods" name="Three methods">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="560" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="Three methods, one planned variable: the language" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="146.25" y="11.1" width="587.51" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="A weakness in one method does not carry into the rest of the claims" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="211.78" y="42.12" width="456.44" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n6" value="RQ1 and RQ3" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6db3;align=center;verticalAlign=middle;fontSize=11;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="108" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="n21" value="&lt;b&gt;Load sweep&lt;/b&gt;&lt;br&gt;&lt;br&gt;Open-loop send schedule from light&lt;br&gt;load to well past saturation.&lt;br&gt;4 variants interleaved inside&lt;br&gt;each of 20 repeats.&lt;br&gt;&lt;br&gt;A second timing splits the core&lt;br&gt;operation from the cross-thread&lt;br&gt;handoff. A third times the contended&lt;br&gt;queue and the reply handle alone.&lt;br&gt;&lt;br&gt;Metric: median, p99, p99.9, p99.99,&lt;br&gt;maximum, peak RSS, CPU, throughput." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="108" width="268" height="336" as="geometry"/>
    </mxCell>
    <mxCell id="n24" value="RQ2" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8b57;align=center;verticalAlign=middle;fontSize=11;fontColor=#1f6b41;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="306" y="76" width="108" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="n39" value="&lt;b&gt;Fault injection&lt;/b&gt;&lt;br&gt;&lt;br&gt;14 small programs, one per&lt;br&gt;class, in both languages.&lt;br&gt;&lt;br&gt;C++ under AddressSanitizer,&lt;br&gt;ThreadSanitizer, and&lt;br&gt;UndefinedBehaviorSanitizer.&lt;br&gt;Safe Rust compiled, and run under a&lt;br&gt;bounded timeout where it builds.&lt;br&gt;&lt;br&gt;No static analyser is run, on purpose.&lt;br&gt;The C++ columns report the tooling&lt;br&gt;this study ran, not a ceiling on C++." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="306" y="108" width="268" height="336" as="geometry"/>
    </mxCell>
    <mxCell id="n42" value="RQ4" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d35400;align=center;verticalAlign=middle;fontSize=11;fontColor=#a04000;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="596" y="76" width="108" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="n56" value="&lt;b&gt;FFI prototype&lt;/b&gt;&lt;br&gt;&lt;br&gt;A C++ host calls an unchanged Rust&lt;br&gt;core across a C ABI, the direction a&lt;br&gt;real migration takes.&lt;br&gt;&lt;br&gt;Per-call cost is measured on a real&lt;br&gt;signalling operation, not inferred&lt;br&gt;from an empty crossing.&lt;br&gt;&lt;br&gt;Memory bugs that cross a language&lt;br&gt;sit at that seam. All unsafe stays&lt;br&gt;there. The core is left free of it." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fff3ec;strokeColor=#d35400;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="596" y="108" width="268" height="336" as="geometry"/>
    </mxCell>
    <mxCell id="n57" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="16" y="460" width="848" height="58" as="geometry"/>
    </mxCell>
    <mxCell id="n58" value="The common control" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#a5700c;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="466.12" width="122.63" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n59" value="both versions are built from one frozen spec. A gap between two" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="196" y="463.07" width="394.85" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n60" value="independently written programs would also carry design, libraries, and skill." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="196" y="478.07" width="482.6" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n61" value="Where a question can be answered with numbers, it uses numbers. Where it cannot, the answer is still by a fixed plan, in words." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="42.01" y="531.08" width="795.97" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="34_fairness_controls" name="Fairness controls">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="580" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="Fairness is a controlled variable, not a claim after the fact" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="74.31" y="11.1" width="731.39" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="The spec is frozen before either version exists. Where the languages cannot be written alike, the gap is logged." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="58.5" y="42.12" width="763.0" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n8" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="430" height="380" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="MATCHED ACROSS BOTH SIDES" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="430" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n13" value="&lt;b&gt;Public API and state machine&lt;/b&gt;&lt;br&gt;&lt;br&gt;Same operations, same illegal-op errors" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="126" width="394" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n17" value="&lt;b&gt;Thread model&lt;/b&gt;&lt;br&gt;&lt;br&gt;Shared-nothing, thread-per-shard, bounded MPSC" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="180" width="394" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n21" value="&lt;b&gt;Allocator and arena count&lt;/b&gt;&lt;br&gt;&lt;br&gt;jemalloc on both, system allocator as control" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="234" width="394" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n25" value="&lt;b&gt;Optimisation level&lt;/b&gt;&lt;br&gt;&lt;br&gt;Never tuned per side" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="288" width="394" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n29" value="&lt;b&gt;Hashing&lt;/b&gt;&lt;br&gt;&lt;br&gt;SplitMix64 for the shard, FNV-1a inside the map" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="342" width="394" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n33" value="&lt;b&gt;Histogram and load schedule&lt;/b&gt;&lt;br&gt;&lt;br&gt;One HDR setup, one open-loop send plan" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="396" width="394" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n38" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="462" y="76" width="402" height="232" as="geometry"/>
    </mxCell>
    <mxCell id="n39" value="LOGGED, NOT RESOLVED" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#a5700c;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="462" y="76" width="402" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n43" value="Bounded queue: Rust sync_channel. C++ mutex and&lt;br&gt;two condition variables." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="126" width="366" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="n47" value="Reply handle: std::promise against a fresh mpsc&lt;br&gt;channel per request." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="170" width="366" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="n51" value="Per-shard map: Each language's own standard hash&lt;br&gt;map." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="214" width="366" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="n55" value="Request encoding: C++ tagged struct 160 B, Rust&lt;br&gt;enum 96 B." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="258" width="366" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="n60" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="462" y="324" width="402" height="132" as="geometry"/>
    </mxCell>
    <mxCell id="n61" value="NOT CONTROLLED" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#a5281b;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="462" y="324" width="402" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n62" value="One person wrote both versions and is" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="365.07" width="231.9" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n63" value="not equally expert in both. Parity bounds" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="381.07" width="256.97" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n64" value="what the code does. It does not bound" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="397.07" width="231.9" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n65" value="speed. This is the main internal threat." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="413.07" width="250.7" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n66" value="The two overload-carrying gaps are the queue and the reply handle. The core-operation gap is the hash map. Rust is 18% longer and 15% simpler." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="-4.99" y="545.08" width="889.99" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="35_parity_oracle" name="Parity and the oracle">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="520" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="Parity is tested, not assumed" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="266.14" y="11.1" width="347.71" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="A cross-diff of two logs cannot tell both-correct from both-wrong in the same way. A third version exists for that." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="48.28" y="42.12" width="783.44" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n5" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="30" y="84" width="36" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="&lt;b&gt;Frozen spec&lt;/b&gt;&lt;br&gt;&lt;br&gt;API, states, data layout, locks, shard size, thread model" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="80" y="80" width="780" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n10" value="" style="html=1;rounded=0;strokeColor=#bcd0e8;strokeWidth=1.6;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="48" y="128" as="sourcePoint"/>
        <mxPoint x="48" y="140" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n12" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="30" y="146" width="36" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n16" value="&lt;b&gt;Two implementations&lt;/b&gt;&lt;br&gt;&lt;br&gt;C++ and Rust, both following the spec, forced gaps logged" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="80" y="142" width="780" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n17" value="" style="html=1;rounded=0;strokeColor=#bcd0e8;strokeWidth=1.6;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="48" y="190" as="sourcePoint"/>
        <mxPoint x="48" y="202" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n19" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="30" y="208" width="36" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n23" value="&lt;b&gt;Language-neutral vectors&lt;/b&gt;&lt;br&gt;&lt;br&gt;Same operations, same seeds, logs diffed line by line" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="80" y="204" width="780" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n24" value="" style="html=1;rounded=0;strokeColor=#bcd0e8;strokeWidth=1.6;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="48" y="252" as="sourcePoint"/>
        <mxPoint x="48" y="264" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n26" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="30" y="270" width="36" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n30" value="&lt;b&gt;Python oracle&lt;/b&gt;&lt;br&gt;&lt;br&gt;223 hand-derived expectations must hold before it may generate" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="80" y="266" width="780" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n31" value="" style="html=1;rounded=0;strokeColor=#bcd0e8;strokeWidth=1.6;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="48" y="314" as="sourcePoint"/>
        <mxPoint x="48" y="326" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n33" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="30" y="332" width="36" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n37" value="&lt;b&gt;Generated campaign&lt;/b&gt;&lt;br&gt;&lt;br&gt;793,000 generated operations, no mismatch" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="80" y="328" width="780" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n38" value="" style="html=1;rounded=0;strokeColor=#bcd0e8;strokeWidth=1.6;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="48" y="376" as="sourcePoint"/>
        <mxPoint x="48" y="388" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n40" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="30" y="394" width="36" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n44" value="&lt;b&gt;Sanitisers on the path taken&lt;/b&gt;&lt;br&gt;&lt;br&gt;C++: ASan, TSan, UBSan. Rust: Miri. A clean result is bounded by the code that ran." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="80" y="390" width="780" height="52" as="geometry"/>
    </mxCell>
    <mxCell id="n45" value="Illegal operations return a typed error and leave the context unchanged." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="214.37" y="477.07" width="451.26" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n46" value="That closed set is what lets the same tests drive both versions along the same paths." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="173.63" y="493.07" width="532.74" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="36_four_variants" name="Four variants">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="520" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="Four variants, interleaved so host noise is shared" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="140.25" y="11.1" width="599.5" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="14 offered-load levels up to 784 kops/s, 20 repeats, 1120 measured runs" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="198.16" y="42.12" width="483.69" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n4" value="jemalloc" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#8794a3;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="201.66" y="79.65" width="56.68" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n5" value="system allocator (control)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#8794a3;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="557.89" y="79.65" width="184.21" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n6" value="C++" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=16;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="14.92" y="152.8" width="26.16" height="24.0" as="geometry"/>
    </mxCell>
    <mxCell id="n7" value="Rust" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=16;fontColor=#1f6b41;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="10.56" y="272.8" width="34.88" height="24.0" as="geometry"/>
    </mxCell>
    <mxCell id="n13" value="&lt;b&gt;C++ + jemalloc&lt;/b&gt;&lt;br&gt;&lt;br&gt;Production-like heap.&lt;br&gt;Compared with Rust + jemalloc&lt;br&gt;to isolate the language." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="80" y="112" width="300" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="n19" value="&lt;b&gt;C++ + system&lt;/b&gt;&lt;br&gt;&lt;br&gt;Control heap.&lt;br&gt;Compared with C++ + jemalloc&lt;br&gt;to isolate the allocator." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#bcd0e8;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="500" y="112" width="300" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="n25" value="&lt;b&gt;Rust + jemalloc&lt;/b&gt;&lt;br&gt;&lt;br&gt;Production-like heap.&lt;br&gt;The pair that answers RQ1 and&lt;br&gt;RQ3 under a matched allocator." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="80" y="248" width="300" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="n31" value="&lt;b&gt;Rust + system&lt;/b&gt;&lt;br&gt;&lt;br&gt;Control heap.&lt;br&gt;A language effect that reverses&lt;br&gt;here is reported as unresolved." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#a8d7bb;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="500" y="248" width="300" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="n32" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="80" y="380" width="720" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n33" value="Inside each repeat the four variants run back to back" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#a5700c;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="96" y="391.65" width="375.51" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n34" value="Interference common to a block is then shared rather than assigned to one variant. A load picked after seeing the sweep cannot enter" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="96" y="415.07" width="827.31" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n35" value="the tested family. That is why the 448 kops/s tracking gap is shown and not tested." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="96" y="431.07" width="520.2" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n36" value="The representative resource load is a chosen value (56 kops/s), not one derived from the sweep." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="142.29" y="485.07" width="595.41" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="37_three_campaigns" name="Three campaigns">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="600" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="Three campaigns, kept apart by prefix" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="218.19" y="11.1" width="443.63" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="A sentence that quotes the wrong prefix is wrong in a way no build gate catches" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="170.91" y="42.12" width="538.19" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n19" value="&lt;b&gt;CANONICAL  (unprefixed)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bare metal, AMD EPYC 7443.&lt;br&gt;SMT off. Governor performance.&lt;br&gt;Boost off. nohz_full. No hypervisor.&lt;br&gt;isolcpus is refused: it pinned a whole&lt;br&gt;earlier campaign onto one core.&lt;br&gt;&lt;br&gt;g++ 15.2.1, rustc 1.97.1.&lt;br&gt;The image pins the gcc-toolset major,&lt;br&gt;not the point release.&lt;br&gt;&lt;br&gt;Role: every result the thesis reports.&lt;br&gt;This is the only dataset in Chapter 5&lt;br&gt;unless a caption says otherwise." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="268" height="420" as="geometry"/>
    </mxCell>
    <mxCell id="n36" value="&lt;b&gt;GUEST  (Guest*)&lt;/b&gt;&lt;br&gt;&lt;br&gt;KVM on Intel(R) Xeon(R) CPU E5-2680 v4.&lt;br&gt;Same design, same code.&lt;br&gt;g++ 15.1.1, one GCC 15 release&lt;br&gt;earlier. rustc matches.&lt;br&gt;&lt;br&gt;On that host the 95% band on one&lt;br&gt;variant's p99 was larger than the gap&lt;br&gt;between all four variants.&lt;br&gt;&lt;br&gt;Role: measurement-validity&lt;br&gt;comparison. It could not resolve&lt;br&gt;the far tail. It is kept, not dropped,&lt;br&gt;so host-owned findings have a&lt;br&gt;counter-example sitting beside them." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="306" y="76" width="268" height="420" as="geometry"/>
    </mxCell>
    <mxCell id="n51" value="&lt;b&gt;SECOND HOST  (Bm*)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bare metal, AMD EPYC 7443P.&lt;br&gt;New shard count, load grid, run&lt;br&gt;count, and compiler as a set.&lt;br&gt;&lt;br&gt;Role: whether findings survive those&lt;br&gt;changes together, not any one of&lt;br&gt;them on its own.&lt;br&gt;&lt;br&gt;The far-tail ranges do not meet.&lt;br&gt;The language RSS gap keeps its&lt;br&gt;sign and size. The allocator-to-&lt;br&gt;language RSS ratio does not travel." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="596" y="76" width="268" height="420" as="geometry"/>
    </mxCell>
    <mxCell id="n52" value="Do not write that the guest and the reported campaign share a toolchain. An image still uses the kernel of the host it sits on." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="42.01" y="565.08" width="795.97" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="38_load_regimes" name="Load regimes (RQ1)">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="620" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="RQ1 splits at saturation, then splits again past it" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="134.25" y="11.1" width="611.49" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="Four operating points, two of them tested, one shown because it was found after the data was in hand" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="99.37" y="42.12" width="681.25" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n4" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#d7dde3;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="40" y="110" width="800" height="8" as="geometry"/>
    </mxCell>
    <mxCell id="n5" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#2e8b57;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="72" y="106" width="16" height="16" as="geometry"/>
    </mxCell>
    <mxCell id="n8" value="56 kops/s" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e8b57;align=center;verticalAlign=middle;fontSize=10;fontColor=#2e8b57;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="36" y="84" width="88" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#2f6db3;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="272" y="106" width="16" height="16" as="geometry"/>
    </mxCell>
    <mxCell id="n12" value="392 kops/s" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6db3;align=center;verticalAlign=middle;fontSize=10;fontColor=#2f6db3;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="236" y="84" width="88" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="n13" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#a5700c;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="492" y="106" width="16" height="16" as="geometry"/>
    </mxCell>
    <mxCell id="n16" value="448 kops/s" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5700c;align=center;verticalAlign=middle;fontSize=10;fontColor=#a5700c;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="456" y="84" width="88" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="n17" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#a5281b;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="752" y="106" width="16" height="16" as="geometry"/>
    </mxCell>
    <mxCell id="n20" value="784 kops/s" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5281b;align=center;verticalAlign=middle;fontSize=10;fontColor=#a5281b;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="716" y="84" width="88" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="n31" value="&lt;b&gt;A.  Below saturation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Four medians within 1.6 us&lt;br&gt;(2.2%). Paired test still&lt;br&gt;finds 1.3 us for Rust.&lt;br&gt;Too small to bound a language&lt;br&gt;effect. Far tail: slowest Rust&lt;br&gt;variant is 50 us below the&lt;br&gt;fastest C++ one. Pooled, not a&lt;br&gt;median of per-run p99.99." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="40" y="160" width="196" height="252" as="geometry"/>
    </mxCell>
    <mxCell id="n42" value="&lt;b&gt;B.  C++ knee&lt;/b&gt;&lt;br&gt;&lt;br&gt;C++ holds to 392&lt;br&gt;kops/s. Rust still tracks.&lt;br&gt;&lt;br&gt;SatKnee is the min of four&lt;br&gt;(392). Do not quote it as&lt;br&gt;where a variant stops coping.&lt;br&gt;Quote each language's tracking&lt;br&gt;load instead." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="252" y="160" width="196" height="252" as="geometry"/>
    </mxCell>
    <mxCell id="n53" value="&lt;b&gt;C.  Descriptive gap&lt;/b&gt;&lt;br&gt;&lt;br&gt;At 448 kops/s offered,&lt;br&gt;Rust still serves&lt;br&gt;448 where C++&lt;br&gt;has fallen to 162.&lt;br&gt;&lt;br&gt;Shown, not tested. Found after&lt;br&gt;the data, so it cannot enter&lt;br&gt;the Holm family." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="464" y="160" width="196" height="252" as="geometry"/>
    </mxCell>
    <mxCell id="n64" value="&lt;b&gt;D.  Overload flip&lt;/b&gt;&lt;br&gt;&lt;br&gt;At 784 kops/s,&lt;br&gt;C++ finishes&lt;br&gt;1.7x as much as&lt;br&gt;Rust.&lt;br&gt;&lt;br&gt;20/20 repeats,&lt;br&gt;both heaps. Holm p&lt;br&gt;at the family floor." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="676" y="160" width="164" height="252" as="geometry"/>
    </mxCell>
    <mxCell id="n65" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f1f4f7;strokeColor=#d7dde3;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="40" y="430" width="800" height="128" as="geometry"/>
    </mxCell>
    <mxCell id="n66" value="Two deployment picks, pointing at opposite sides" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="56" y="441.65" width="340.08" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n71" value="&lt;b&gt;Sized to run below each variant's knee&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pick the variant that holds its sent rate further.&lt;br&gt;That pick is shown, not tested." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="56" y="472" width="372" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="n76" value="&lt;b&gt;A signal storm will drive past each knee&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pick the variant that still finishes more work then.&lt;br&gt;That pick is tested. It is C++ here." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="448" y="472" width="376" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="n77" value="A test that stopped at a load the service still meets would have pointed the other way with the same setup." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="104.69" y="585.08" width="670.62" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="39_what_clock_measures" name="What the clock measures">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="560" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="What the end-to-end clock can and cannot say" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="176.22" y="11.1" width="527.56" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="An operation in this design is a fraction of a percent of the round-trip. That clock cannot bound a language effect." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="44.87" y="42.12" width="790.25" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n8" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="848" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="ONE END-TO-END ROUND-TRIP" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="848" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n10" value="Language work (the core)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="36" y="120.6" width="156.96" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n11" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#2e8b57;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="36" y="144" width="8" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n12" value="0.250% of the sweep" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f6b41;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="52" y="150.6" width="124.26" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n13" value="Cross-thread handoff (operating system)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="36" y="184.6" width="255.06" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n14" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#2f6db3;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="36" y="208" width="790" height="14" as="geometry"/>
    </mxCell>
    <mxCell id="n15" value="the remaining 99.750%" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="224.6" width="137.34" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n24" value="&lt;b&gt;What the sweep times&lt;/b&gt;&lt;br&gt;&lt;br&gt;Producer to shard queue to worker&lt;br&gt;to one-shot reply. Most of that time&lt;br&gt;is passing work between threads.&lt;br&gt;&lt;br&gt;Paired median gap: 1.3 us.&lt;br&gt;Real, and too small to attribute." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="256" width="270" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="n36" value="&lt;b&gt;What the microbench times&lt;/b&gt;&lt;br&gt;&lt;br&gt;The core called directly, with no&lt;br&gt;queue and no reply handle.&lt;br&gt;&lt;br&gt;Rust is 1.6x faster.&lt;br&gt;Likely cause: stock hash-map layout,&lt;br&gt;not the safe-code model.&lt;br&gt;&lt;br&gt;Both sit inside the sweep's blind&lt;br&gt;zone by a factor of 38." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="304" y="256" width="270" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="n47" value="&lt;b&gt;What this forbids&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bounding a language effect from&lt;br&gt;the end-to-end median.&lt;br&gt;&lt;br&gt;Calling the two languages&lt;br&gt;equivalent because the sweep&lt;br&gt;cannot tell them apart.&lt;br&gt;&lt;br&gt;cannot tell is not equivalent." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=11.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="592" y="256" width="272" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="n48" value="Point (5) of the abstract is written this way on purpose: the paired gap is reported, then refused as a bound." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="95.29" y="525.08" width="689.42" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="40_holm_family" name="Holm family">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="580" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="The tested family is fixed before the campaign" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="164.23" y="11.1" width="551.54" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="Exact paired permutation tests over 20 interleaved repeats, Holm-corrected across 14 comparisons" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="113.0" y="42.12" width="654.0" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n8" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="420" height="380" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="IN THE FAMILY" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#2e8b57;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="420" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n14" value="&lt;b&gt;Median, p99, p99.9 at the chosen load&lt;/b&gt;&lt;br&gt;&lt;br&gt;Unit is the run. Pairing can cancel shared&lt;br&gt;noise." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="126" width="384" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="n18" value="&lt;b&gt;Overload throughput and CPU per finished call&lt;/b&gt;&lt;br&gt;&lt;br&gt;The largest language effect in the family." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="206" width="384" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="n23" value="&lt;b&gt;Peak RSS language and allocator contrasts&lt;/b&gt;&lt;br&gt;&lt;br&gt;A run-level max, so a handful of stalls do not&lt;br&gt;move it." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="286" width="384" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="n28" value="&lt;b&gt;Allocator held fixed inside each comparison&lt;/b&gt;&lt;br&gt;&lt;br&gt;A result that reverses across heaps is&lt;br&gt;unresolved." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="366" width="384" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="n33" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="452" y="76" width="412" height="380" as="geometry"/>
    </mxCell>
    <mxCell id="n34" value="KEPT OUT, WITH A REASON" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#a5281b;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="452" y="76" width="412" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n38" value="&lt;b&gt;Jitter from one call to the next&lt;/b&gt;&lt;br&gt;&lt;br&gt;No research question asks for it." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="126" width="376" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="n44" value="&lt;b&gt;Pooled p99.99 far tail&lt;/b&gt;&lt;br&gt;&lt;br&gt;Unit is the operation, not the run. No&lt;br&gt;across-repeat interval to test. No fallback&lt;br&gt;to per-run p9999." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="206" width="376" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="n49" value="&lt;b&gt;The 448 kops/s tracking gap&lt;/b&gt;&lt;br&gt;&lt;br&gt;Operating point found after the data. Shown,&lt;br&gt;not tested." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="286" width="376" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="n54" value="&lt;b&gt;Achieved throughput below saturation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pinned to offered load by construction, so&lt;br&gt;it cannot express a language effect." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="366" width="376" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="n55" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="16" y="472" width="848" height="64" as="geometry"/>
    </mxCell>
    <mxCell id="n56" value="Floors, quoted so a null can be told from a math limit" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#a5700c;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="484.12" width="367.88" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n57" value="Uncorrected floor p = 0.0000019. Holm-corrected floor 0.000027. When interval and p-value disagree, pairing decides." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="507.07" width="727.03" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n58" value="Applying the reading rule to the block that suits the argument, and dropping it for the other, is the failure pre-commitment exists to prevent." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="-8.13" y="549.08" width="896.25" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="41_rq2_catalogue" name="RQ2 catalogue">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="700" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="RQ2 is two-sided: seven inside the guarantee, seven outside it" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="68.31" y="11.1" width="743.38" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="The seam double-free is the in-guarantee double-free rewritten through unsafe, not a new class" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="119.81" y="42.12" width="640.38" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n8" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="16" y="72" width="420" height="430" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="INSIDE: compile error in safe Rust" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#2e8b57;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="72" width="420" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n13" value="&lt;b&gt;Use-after-free&lt;/b&gt;&lt;br&gt;&lt;br&gt;C++: ASan + TSan at runtime" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="124" width="384" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n17" value="&lt;b&gt;Double-free&lt;/b&gt;&lt;br&gt;&lt;br&gt;C++: ASan at runtime" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="176" width="384" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n21" value="&lt;b&gt;Iterator invalidation&lt;/b&gt;&lt;br&gt;&lt;br&gt;C++: ASan + TSan at runtime" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="228" width="384" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n25" value="&lt;b&gt;Data race&lt;/b&gt;&lt;br&gt;&lt;br&gt;C++: TSan at runtime" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="280" width="384" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n29" value="&lt;b&gt;Unguarded shared mutation&lt;/b&gt;&lt;br&gt;&lt;br&gt;C++: TSan at runtime" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="332" width="384" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n34" value="&lt;b&gt;Use-after-move&lt;/b&gt;&lt;br&gt;&lt;br&gt;C++: no sanitiser flags it. A moved-from object is&lt;br&gt;still valid." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="384" width="384" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n38" value="&lt;b&gt;Thread-unsafe handle shared&lt;/b&gt;&lt;br&gt;&lt;br&gt;C++: TSan at runtime" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34" y="436" width="384" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n43" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="452" y="72" width="412" height="430" as="geometry"/>
    </mxCell>
    <mxCell id="n44" value="OUTSIDE: compiles and fails in both" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#a5281b;strokeColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="452" y="72" width="412" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n49" value="&lt;b&gt;Lock-order deadlock&lt;/b&gt;&lt;br&gt;&lt;br&gt;TSan hit 5 of 12 runs. Rate jumps. Do not quote&lt;br&gt;it from memory." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="124" width="376" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n54" value="&lt;b&gt;Lost update&lt;/b&gt;&lt;br&gt;&lt;br&gt;Each access is synced, so TSan has no race to&lt;br&gt;find. Silent in both." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="176" width="376" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n59" value="&lt;b&gt;Reference-cycle leak&lt;/b&gt;&lt;br&gt;&lt;br&gt;Leaks are safe in Rust by design. LeakSanitizer&lt;br&gt;flags C++." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="228" width="376" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n63" value="&lt;b&gt;Integer overflow (release)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rust defines wrap. UBSan flags C++." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="280" width="376" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n68" value="&lt;b&gt;Worker-failure blast radius&lt;/b&gt;&lt;br&gt;&lt;br&gt;A failed worker takes its shard. Undetected on&lt;br&gt;both sides." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="332" width="376" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n73" value="&lt;b&gt;Forgotten lock guard&lt;/b&gt;&lt;br&gt;&lt;br&gt;RAII removes the plain missed-unlock. Both&lt;br&gt;forgotten-guard programs hang." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="384" width="376" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n78" value="&lt;b&gt;Seam double-free&lt;/b&gt;&lt;br&gt;&lt;br&gt;Same C++ half. Only the Rust column moves. Miri&lt;br&gt;flags it. The C++ host is out of Miri's reach." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="436" width="376" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n79" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f1f4f7;strokeColor=#d7dde3;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="16" y="518" width="848" height="128" as="geometry"/>
    </mxCell>
    <mxCell id="n80" value="How the rest are caught, when they are caught" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="529.65" width="318.83" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n85" value="&lt;b&gt;Without a rewrite&lt;/b&gt;&lt;br&gt;&lt;br&gt;LeakSanitizer and UBSan flag on&lt;br&gt;the C++ programs as written." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="558" width="260" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="n91" value="&lt;b&gt;After a recast&lt;/b&gt;&lt;br&gt;&lt;br&gt;Loom and Shuttle flag the two&lt;br&gt;concurrency boundary cases only&lt;br&gt;once rewritten into their parts." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="308" y="558" width="260" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="n97" value="&lt;b&gt;What this is not&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rust does not drop race conditions,&lt;br&gt;lock order, leaks, wrapping, or the&lt;br&gt;blast radius of a failed worker." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="584" y="558" width="260" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="n98" value="A compiler that will not build a program rules the defect out of each run. A sanitiser rules it out only of the runs a sanitiser test happens to take." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="-30.06" y="667.08" width="940.12" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="42_hypothesis_verdicts" name="Hypothesis verdicts">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="600" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="How the three hypotheses came out" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="242.16" y="11.1" width="395.67" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="Saying this in public is what sets a test apart from a sketch" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="232.22" y="42.12" width="415.56" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n12" value="&lt;b&gt;H1  The median clause holds. The far-tail clause does not. Overload was never named.&lt;/b&gt;&lt;br&gt;&lt;br&gt;The paired test resolves 1.3 us, too small to bound a language effect.&lt;br&gt;The reported campaign now resolves the far tail, in Rust's favour.&lt;br&gt;A second bare-metal host agrees on the direction.&lt;br&gt;H1 was right about where a below-saturation gap would show up,&lt;br&gt;and wrong that it was the only place. It was also not well posed.&lt;br&gt;Performance-equivalent reads as one quantity and names at least three." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="848" height="148" as="geometry"/>
    </mxCell>
    <mxCell id="n18" value="&lt;b&gt;Quantity 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;Delivered round-trip below&lt;br&gt;saturation. Practically a tie.&lt;br&gt;Cannot bound a language effect." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="240" width="270" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="n24" value="&lt;b&gt;Quantity 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;Code the compilers emit. Core&lt;br&gt;call 1.6x faster in Rust.&lt;br&gt;Hash-map layout, not checks." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="304" y="240" width="270" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="n30" value="&lt;b&gt;Quantity 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sustained work under overload.&lt;br&gt;C++ holds 1.7x the rate.&lt;br&gt;The largest tested effect." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="592" y="240" width="272" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="n38" value="&lt;b&gt;H2  Holds for its seven. Fails the looser reading.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Accepted for memory safety and data-race&lt;br&gt;freedom. Rejected for concurrency correctness&lt;br&gt;at large. A claim about safe Rust only.&lt;br&gt;The seam case shows the same class returning&lt;br&gt;inside unsafe." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="388" width="416" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="n46" value="&lt;b&gt;H3  Supported by a bound, not by a miss.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Any per-call tax is bounded at 10.91% of&lt;br&gt;that signalling call. That is support from a bound&lt;br&gt;on a cost the measurement could have missed.&lt;br&gt;The claim that the real cost is design and training&lt;br&gt;is supported structurally, not statistically." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="448" y="388" width="416" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="n47" value="Chapter 6 revisits all three against the facts. The abstract's conclusions paragraph is the short form of this page." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="76.49" y="565.08" width="727.03" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="43_rss_two_effects" name="RSS and CPU (RQ3)">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="560" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="Peak RSS: two real effects of the same order on bare metal" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="92.29" y="11.1" width="695.42" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="Never write that the allocator effect is the larger one. Never quote their ratio without naming a host." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="89.16" y="42.12" width="701.69" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n15" value="&lt;b&gt;Language effect (travels)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rust uses 1.4 to 2.5 MiB more&lt;br&gt;peak RAM than C++ under either heap.&lt;br&gt;Same sign and size on all three hosts.&lt;br&gt;&lt;br&gt;It is a fixed cost, not a cost per UE. The&lt;br&gt;quiet host is where that can be seen.&lt;br&gt;jemalloc's own counts put the extra past&lt;br&gt;the heap, in the runtime a Rust process&lt;br&gt;carries before it gets RAM." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="416" height="220" as="geometry"/>
    </mxCell>
    <mxCell id="n28" value="&lt;b&gt;Allocator effect (host-dependent ratio)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Linking jemalloc at all costs 1.5 to&lt;br&gt;2.4 MiB in either language.&lt;br&gt;&lt;br&gt;On the guest that extra was 13 times the&lt;br&gt;language effect. On both bare-metal hosts&lt;br&gt;the two are comparable.&lt;br&gt;&lt;br&gt;The transparent hugepage policy is the&lt;br&gt;named candidate. The study does not claim&lt;br&gt;causation. Future work can vary it." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="448" y="76" width="416" height="220" as="geometry"/>
    </mxCell>
    <mxCell id="n35" value="&lt;b&gt;CPU below saturation&lt;/b&gt;&lt;br&gt;&lt;br&gt;At 56 kops/s Rust uses at&lt;br&gt;most 5.1 percentage points&lt;br&gt;less. Scoped to that load, not to&lt;br&gt;the whole below-saturation band." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="314" width="270" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="n42" value="&lt;b&gt;CPU past saturation&lt;/b&gt;&lt;br&gt;&lt;br&gt;The slower variant spends 1.8x&lt;br&gt;the CPU per finished call. That is&lt;br&gt;effort spent without finishing.&lt;br&gt;The sign of CPU hangs on the load." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="304" y="314" width="270" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="n49" value="&lt;b&gt;A contrary result, reread&lt;/b&gt;&lt;br&gt;&lt;br&gt;Karlbäck reports Rust lowest on&lt;br&gt;RAM. Those variants are two&lt;br&gt;concurrency runtimes (Boost.Fibers&lt;br&gt;vs Tokio), not two languages." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#ffffff;strokeColor=#d7dde3;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="592" y="314" width="272" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="n50" value="A single number for the CPU cost of Rust's safe-code model would mix two loads that move in opposite ways." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="107.82" y="525.08" width="664.36" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="44_adoption_axes" name="Adoption axes (RQ4)">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="580" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="RQ4: cheap in the machine, costly in the people" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="158.24" y="11.1" width="563.53" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="A C++ host can call an unchanged Rust core. All unsafe stays in 9 functions. The core has 0 unsafe sites." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="82.34" y="42.12" width="715.31" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n13" value="&lt;b&gt;Seam structure&lt;/b&gt;&lt;br&gt;&lt;br&gt;11 C entry points in&lt;br&gt;231 lines of Rust.&lt;br&gt;9 functions hold all&lt;br&gt;raw pointers. Core is clean.&lt;br&gt;&lt;br&gt;Final. Read off the code.&lt;br&gt;Does not depend on host." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="200" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="n23" value="&lt;b&gt;Per-call tax&lt;/b&gt;&lt;br&gt;&lt;br&gt;Native 12.3 us.&lt;br&gt;Through the seam 12.7 us.&lt;br&gt;Bound: 10.91% of that call.&lt;br&gt;&lt;br&gt;Timed on a real signal, not&lt;br&gt;an empty crossing. A no-op&lt;br&gt;crossing bounds itself." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="232" y="76" width="200" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="n33" value="&lt;b&gt;Build time&lt;/b&gt;&lt;br&gt;&lt;br&gt;54% of the Rust clean&lt;br&gt;build is third-party code.&lt;br&gt;Own source builds in&lt;br&gt;0.8x the CPU g++ needs.&lt;br&gt;&lt;br&gt;The host-sensitive axis.&lt;br&gt;Quote the paired ratio." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="448" y="76" width="200" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="n43" value="&lt;b&gt;Shipped size&lt;/b&gt;&lt;br&gt;&lt;br&gt;The 6.8x gap compares&lt;br&gt;two linkage policies. Order&lt;br&gt;flips if policy is matched.&lt;br&gt;&lt;br&gt;Compared part: 0 crates,&lt;br&gt;0 unsafe sites. Never&lt;br&gt;quote that ratio alone." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fff3ec;strokeColor=#d35400;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="664" y="76" width="200" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="n44" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f1f4f7;strokeColor=#d7dde3;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="16" y="396" width="848" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="n45" value="Where C++ still leads, and the limit of the seam" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="407.65" width="340.08" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n46" value="The edit and compile loop for a change that stays inside one source file is faster in C++. That is the one axis of outright lead." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="432.6" width="843.66" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n47" value="Keeping unsafe at the seam bounds what has to be checked, not what can be corrupted. Host and part share one address space." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="450.6" width="804.42" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n48" value="A vendor worried about build time or footprint should audit its crate budget (54% of CPU is dependencies) before blaming the compiler." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="468.6" width="876.36" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n49" value="The C++ unsafe cell stays blank on purpose. The language marks no such region." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="195.57" y="545.08" width="488.87" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="45_guidelines" name="Engineering guidelines">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="560" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="Engineering guidelines, each carrying the limit of its finding" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="68.31" y="11.1" width="743.38" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="These are the practical form of Chapter 6, not a vendor playbook detached from the evidence" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="130.03" y="42.12" width="619.94" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n5" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="24" y="86" width="32" height="32" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="&lt;b&gt;Choose a first part for how thin its API is, not for its size.&lt;/b&gt;&lt;br&gt;&lt;br&gt;The rewrite of a rich interface is the schedule risk. The edge itself is not." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="68" y="78" width="792" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n11" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="24" y="154" width="32" height="32" as="geometry"/>
    </mxCell>
    <mxCell id="n15" value="&lt;b&gt;Keep the C ABI in its own crate and the core free of unsafe.&lt;/b&gt;&lt;br&gt;&lt;br&gt;That keeps unsafe out of the crate chains it spreads through." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="68" y="146" width="792" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n17" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="24" y="222" width="32" height="32" as="geometry"/>
    </mxCell>
    <mxCell id="n21" value="&lt;b&gt;Leave the concurrency review budget where it is.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Taking Rust drops data races. It leaves the class that fails in silence." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="68" y="214" width="792" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n23" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="24" y="290" width="32" height="32" as="geometry"/>
    </mxCell>
    <mxCell id="n27" value="&lt;b&gt;Prefer a shared-nothing structure in either language.&lt;/b&gt;&lt;br&gt;&lt;br&gt;The strongest concurrency result here belongs to the design and to neither compiler." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="68" y="282" width="792" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n29" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="24" y="358" width="32" height="32" as="geometry"/>
    </mxCell>
    <mxCell id="n33" value="&lt;b&gt;Plan the learning curve as a training cost and track it.&lt;/b&gt;&lt;br&gt;&lt;br&gt;H3's human-cost claim is structural, not statistical." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="68" y="350" width="792" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n35" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="24" y="426" width="32" height="32" as="geometry"/>
    </mxCell>
    <mxCell id="n39" value="&lt;b&gt;Time the part as well as the round-trip. Sweep past the knee.&lt;/b&gt;&lt;br&gt;&lt;br&gt;The rule this study would most like to have used from the start." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="68" y="418" width="792" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n40" value="A plan that reads memory-safe as concurrency-safe would mis-budget its review effort. Memory-safety bugs in Rust involve unsafe." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="38.88" y="525.08" width="802.24" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="46_cannot_support" name="Limits and next work">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="620" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="What this study cannot support, and what it would do next" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="98.28" y="11.1" width="683.43" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="The first professional duty is not to claim too much. The second is how far the data reaches." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="123.22" y="42.12" width="633.56" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n8" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="16" y="72" width="848" height="196" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="THREE THREATS THAT STILL MATTER" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#a5281b;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="72" width="848" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n17" value="&lt;b&gt;Single-author skill&lt;/b&gt;&lt;br&gt;&lt;br&gt;One person wrote both versions.&lt;br&gt;In this field a code review then&lt;br&gt;more speed work flipped a printed&lt;br&gt;verdict from comparable to Rust&lt;br&gt;worse by 85 to 91%." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="120" width="260" height="128" as="geometry"/>
    </mxCell>
    <mxCell id="n25" value="&lt;b&gt;The clock times the design&lt;/b&gt;&lt;br&gt;&lt;br&gt;End-to-end answers the question a&lt;br&gt;vendor sizing a node would ask.&lt;br&gt;It answers the language question&lt;br&gt;hardly at all. The core timing is&lt;br&gt;the supplement, and it is narrower." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="308" y="120" width="260" height="128" as="geometry"/>
    </mxCell>
    <mxCell id="n33" value="&lt;b&gt;One subsystem, one mix&lt;/b&gt;&lt;br&gt;&lt;br&gt;Call mix is not a public cell mix.&lt;br&gt;A different mix moves both sides&lt;br&gt;the same way. It limits how far&lt;br&gt;the numbers travel. It does not&lt;br&gt;make the test unfair." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="584" y="120" width="260" height="128" as="geometry"/>
    </mxCell>
    <mxCell id="n38" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="16" y="284" width="848" height="248" as="geometry"/>
    </mxCell>
    <mxCell id="n39" value="NAMED NEXT EXPERIMENTS" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="284" width="848" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n46" value="&lt;b&gt;Hugepage policy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vary it on one host with all else&lt;br&gt;fixed. The three hosts disagree&lt;br&gt;about the allocator-to-language&lt;br&gt;RSS ratio." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="332" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n51" value="&lt;b&gt;Production traces&lt;/b&gt;&lt;br&gt;&lt;br&gt;Replay anonymised traces to check&lt;br&gt;the call mix." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="308" y="332" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n57" value="&lt;b&gt;Shared mutable state&lt;/b&gt;&lt;br&gt;&lt;br&gt;A part that is not shared-nothing&lt;br&gt;would work the two sides in a way&lt;br&gt;this design does not." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="584" y="332" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n62" value="&lt;b&gt;Async vs thread-per-shard&lt;/b&gt;&lt;br&gt;&lt;br&gt;Split the runtime from the&lt;br&gt;language in the tail result." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="420" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n67" value="&lt;b&gt;Two heaps in one process&lt;/b&gt;&lt;br&gt;&lt;br&gt;Price what keeping a core free of&lt;br&gt;unsafe is worth." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="308" y="420" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n73" value="&lt;b&gt;Longer case study&lt;/b&gt;&lt;br&gt;&lt;br&gt;Track defect counts and review&lt;br&gt;effort while adding Rust a piece&lt;br&gt;at a time." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="584" y="420" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n74" value="A deadlocked control plane is an outage. A lost counter update that stays silent can misinform a mobility decision. Nothing shown here stops either." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="-23.8" y="585.08" width="927.59" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="47_claim_register" name="Claim register">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="600" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="A register of what a sentence is allowed to say" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="158.24" y="11.1" width="563.53" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="The defect that costs a grade is a correct statement attached to the wrong scope" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="167.5" y="42.12" width="545.0" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n12" value="&lt;b&gt;FINAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;compilers and source&lt;br&gt;&lt;br&gt;RQ2 compile outcomes&lt;br&gt;Seam size, unsafe sites&lt;br&gt;Size and complexity&lt;br&gt;Transcript parity" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="208" height="360" as="geometry"/>
    </mxCell>
    <mxCell id="n21" value="&lt;b&gt;HOST-SENSITIVE&lt;/b&gt;&lt;br&gt;&lt;br&gt;say which host&lt;br&gt;&lt;br&gt;Tail latency, overload&lt;br&gt;CPU (sign hangs on load)&lt;br&gt;Absolute build times&lt;br&gt;Allocator / language RSS" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="232" y="76" width="208" height="360" as="geometry"/>
    </mxCell>
    <mxCell id="n30" value="&lt;b&gt;TRAVELS&lt;/b&gt;&lt;br&gt;&lt;br&gt;all three hosts agree&lt;br&gt;&lt;br&gt;Language RSS, a few MiB&lt;br&gt;Far-tail direction on&lt;br&gt;both bare-metal hosts&lt;br&gt;Paired build-time ratio" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="448" y="76" width="208" height="360" as="geometry"/>
    </mxCell>
    <mxCell id="n41" value="&lt;b&gt;REFUSED&lt;/b&gt;&lt;br&gt;&lt;br&gt;do not write&lt;br&gt;&lt;br&gt;equivalent from cannot tell&lt;br&gt;isolcpus as a tuning step&lt;br&gt;Guest and main share a&lt;br&gt;toolchain&lt;br&gt;Shipped size as language&lt;br&gt;TSan rate from memory" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="664" y="76" width="208" height="360" as="geometry"/>
    </mxCell>
    <mxCell id="n42" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f1f4f7;strokeColor=#d7dde3;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="16" y="456" width="848" height="92" as="geometry"/>
    </mxCell>
    <mxCell id="n43" value="Three live traps for a generated macro" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="467.65" width="269.23" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n44" value="A Pct macro read as a multiple. A lo-hi range wrapped in math mode, which typesets as two minus signs. A quantity that is right where it" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="490.6" width="889.44" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n45" value="is derived and wrong at every site that summarises it (CpuDiffAbsMax is scoped to ReprLoad, not to the whole below-saturation regime)." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="508.6" width="876.36" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n46" value="These pages quote the same macros the prose does. If a fresh campaign moves a number, rebuild this pack with the same command." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="45.15" y="565.08" width="789.71" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="48_ngran_two_splits" name="gNB two splits">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="560" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="The gNB is split twice. UECM sits in one of those boxes." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="104.28" y="11.1" width="671.44" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="The first split is central versus distributed. The second is control versus user plane inside the central unit." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="61.91" y="42.12" width="756.19" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n6" value="UE" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f1f4f7;strokeColor=#d7dde3;align=center;verticalAlign=middle;fontSize=16;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="76" width="72" height="88" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="gNB-DU" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dce8f7;strokeColor=#2f6db3;align=center;verticalAlign=middle;fontSize=15;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="140" y="76" width="100" height="88" as="geometry"/>
    </mxCell>
    <mxCell id="n10" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="96" y="120" as="sourcePoint"/>
        <mxPoint x="136" y="120" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n11" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=24;fillColor=#f1f4f7;strokeColor=#d7dde3;strokeWidth=1.6;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="280" y="68" width="380" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="n12" value="gNB-CU" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#8794a3;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="448.75" y="77.65" width="42.51" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n17" value="&lt;b&gt;gNB-CU-CP  (this thesis)&lt;/b&gt;&lt;br&gt;&lt;br&gt;RRC, mobility, UE context.&lt;br&gt;UE Context Management lives here." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="300" y="104" width="340" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="n21" value="&lt;b&gt;gNB-CU-UP&lt;/b&gt;&lt;br&gt;&lt;br&gt;User-plane forwarding. Not measured." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#f4fbf6;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="300" y="184" width="340" height="68" as="geometry"/>
    </mxCell>
    <mxCell id="n24" value="5G Core" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f1f4f7;strokeColor=#d7dde3;align=center;verticalAlign=middle;fontSize=15;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="700" y="76" width="160" height="88" as="geometry"/>
    </mxCell>
    <mxCell id="n25" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="244" y="120" as="sourcePoint"/>
        <mxPoint x="276" y="120" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n26" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="664" y="120" as="sourcePoint"/>
        <mxPoint x="696" y="120" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n27" value="Uu" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="112.0" y="167.55" width="11.99" height="16.5" as="geometry"/>
    </mxCell>
    <mxCell id="n28" value="F1" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="252.0" y="167.55" width="11.99" height="16.5" as="geometry"/>
    </mxCell>
    <mxCell id="n29" value="NG" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="676.0" y="167.55" width="11.99" height="16.5" as="geometry"/>
    </mxCell>
    <mxCell id="n30" value="E1 between CU-CP and CU-UP" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="392.06" y="257.55" width="155.87" height="16.5" as="geometry"/>
    </mxCell>
    <mxCell id="n39" value="&lt;b&gt;Why this part&lt;/b&gt;&lt;br&gt;&lt;br&gt;UECM owns per-UE control state.&lt;br&gt;Many UEs at once. Strict lifecycle.&lt;br&gt;Millisecond-scale signalling budgets.&lt;br&gt;Small enough to specify in full and&lt;br&gt;build twice. Hard enough to stand in&lt;br&gt;for this class of service." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="20" y="300" width="270" height="168" as="geometry"/>
    </mxCell>
    <mxCell id="n48" value="&lt;b&gt;What the splits buy&lt;/b&gt;&lt;br&gt;&lt;br&gt;DU sits close to the radio.&lt;br&gt;CU-CP can run on ordinary servers.&lt;br&gt;Open-RAN lets each box come from&lt;br&gt;a different vendor.&lt;br&gt;A defect here is then network-wide,&lt;br&gt;not local to one vendor's metal." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="306" y="300" width="270" height="168" as="geometry"/>
    </mxCell>
    <mxCell id="n57" value="&lt;b&gt;What this is not&lt;/b&gt;&lt;br&gt;&lt;br&gt;Not the user plane.&lt;br&gt;Not PHY or layer 2.&lt;br&gt;Not a packet processor.&lt;br&gt;Findings travel to other stateful,&lt;br&gt;partitionable control-plane&lt;br&gt;services of this kind." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="592" y="300" width="268" height="168" as="geometry"/>
    </mxCell>
    <mxCell id="n58" value="Figure ngran in the thesis is the compact form. This page is the reading aid for the two-axis split." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="126.62" y="525.08" width="626.75" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="49_open_loop" name="Open loop">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="560" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="The sender keeps to its plan, even when the service is late" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="86.3" y="11.1" width="707.41" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="A closed-loop sender stops while a stall is in progress. It then never records the delay of that stall." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="89.16" y="42.12" width="701.69" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n8" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="416" height="280" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="CLOSED LOOP  (not used)" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#a5281b;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="416" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n10" value="1. Send a request." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="115.65" width="127.53" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n11" value="2. Wait for the reply." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="137.65" width="155.87" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n12" value="3. Only then send the next one." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="159.65" width="219.64" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n19" value="&lt;b&gt;What goes wrong&lt;/b&gt;&lt;br&gt;&lt;br&gt;During a stall the sender is idle.&lt;br&gt;The histogram never sees the wait.&lt;br&gt;Overload looks milder than it is.&lt;br&gt;That is coordinated omission." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="210" width="376" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="n24" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="448" y="76" width="416" height="280" as="geometry"/>
    </mxCell>
    <mxCell id="n25" value="OPEN LOOP  (this study)" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#2e8b57;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="448" y="76" width="416" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n26" value="1. Keep the send times on a schedule." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="468" y="115.65" width="262.15" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n27" value="2. Do not wait for replies." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="468" y="137.65" width="191.3" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n28" value="3. Time from the intended send time." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="468" y="159.65" width="255.06" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n35" value="&lt;b&gt;What that records&lt;/b&gt;&lt;br&gt;&lt;br&gt;A stall still occupies its slot.&lt;br&gt;The HDR histogram is corrected so&lt;br&gt;missing replies cannot hide delay.&lt;br&gt;Overload shows up as delay." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="468" y="210" width="376" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="n36" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="16" y="376" width="848" height="124" as="geometry"/>
    </mxCell>
    <mxCell id="n37" value="The queue is bounded on purpose" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="387.65" width="219.64" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n38" value="When it is full the caller blocks. A drop rule would hide overload." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="412.12" width="456.44" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n39" value="This study needs overload to show up as delay, not as lost work the" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="430.12" width="456.44" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n40" value="histogram never sees. The same reason the send schedule is open-loop." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="448.12" width="470.06" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n41" value="Schroeder and Harchol-Balter: an open arrival process is what a control plane under a storm actually looks like." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="89.02" y="525.08" width="701.96" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="50_request_path" name="One request path">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="520" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="One request, from the producer to the reply" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="182.21" y="11.1" width="515.57" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="Most of this path is passing work between threads. That is why the end-to-end clock cannot bound a language effect." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="48.28" y="42.12" width="783.44" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n10" value="&lt;b&gt;Producer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Load generator.&lt;br&gt;Hashes ue_id.&lt;br&gt;Waits on a one-shot&lt;br&gt;reply handle." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="88" width="160" height="188" as="geometry"/>
    </mxCell>
    <mxCell id="n16" value="&lt;b&gt;MPSC queue&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bounded. FIFO.&lt;br&gt;Blocks when full.&lt;br&gt;One queue per shard." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="188" y="88" width="160" height="188" as="geometry"/>
    </mxCell>
    <mxCell id="n23" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;&lt;br&gt;The only thread&lt;br&gt;that may touch this&lt;br&gt;shard. No lock on&lt;br&gt;context state." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="360" y="88" width="160" height="188" as="geometry"/>
    </mxCell>
    <mxCell id="n30" value="&lt;b&gt;Shard map&lt;/b&gt;&lt;br&gt;&lt;br&gt;Language's own&lt;br&gt;hash map. This is&lt;br&gt;the core the second&lt;br&gt;clock times." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="532" y="88" width="160" height="188" as="geometry"/>
    </mxCell>
    <mxCell id="n37" value="&lt;b&gt;Reply&lt;/b&gt;&lt;br&gt;&lt;br&gt;Result goes back&lt;br&gt;on the one-shot&lt;br&gt;handle. Producer&lt;br&gt;unblocks." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=11.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="704" y="88" width="160" height="188" as="geometry"/>
    </mxCell>
    <mxCell id="n38" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="180" y="182" as="sourcePoint"/>
        <mxPoint x="200" y="182" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n39" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="352" y="182" as="sourcePoint"/>
        <mxPoint x="372" y="182" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n40" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="524" y="182" as="sourcePoint"/>
        <mxPoint x="544" y="182" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n41" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="696" y="182" as="sourcePoint"/>
        <mxPoint x="716" y="182" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n42" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="16" y="300" width="332" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="n43" value="Timed apart: the core" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f6b41;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="311.65" width="148.79" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n44" value="Shard map only. No queue." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="336.6" width="163.5" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n45" value="Rust is 1.6x faster." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="354.6" width="130.8" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n46" value="0.250% of the round-trip." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="372.6" width="163.5" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n47" value="Likely hash-map layout." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="390.6" width="150.42" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n48" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="364" y="300" width="500" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="n49" value="Timed together: the round-trip" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#a5700c;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="380" y="311.65" width="212.55" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n50" value="Producer to queue to worker to map to reply." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="380" y="336.6" width="287.76" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n51" value="Paired median gap 1.3 us. Real, too small to attribute." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="380" y="354.6" width="359.7" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n52" value="The rest is operating-system handoff." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="380" y="372.6" width="241.98" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n53" value="That clock answers a vendor sizing a node, not a language comparison." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="380" y="390.6" width="451.26" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n54" value="The only shared mutable state either version allows is one atomic counter. No control flow depends on its value." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="89.02" y="485.07" width="701.96" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="51_one_repeat" name="One interleaved repeat">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="500" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="Inside one repeat the four variants run back to back" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="128.26" y="11.1" width="623.48" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="20 repeats. 14 loads. 1120 measured runs. Interleaving makes host noise common to a block." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="133.44" y="42.12" width="613.13" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n4" value="ONE REPEAT, ONE LOAD" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#8794a3;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="374.6" y="76.6" width="130.8" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n8" value="&lt;b&gt;C++  jemalloc&lt;/b&gt;&lt;br&gt;&lt;br&gt;same seed, same ops" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="40" y="104" width="190" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n12" value="&lt;b&gt;C++  system&lt;/b&gt;&lt;br&gt;&lt;br&gt;same seed, same ops" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#dce8f7;strokeColor=#2f6db3;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="250" y="104" width="190" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n16" value="&lt;b&gt;Rust  jemalloc&lt;/b&gt;&lt;br&gt;&lt;br&gt;same seed, same ops" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="460" y="104" width="190" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n20" value="&lt;b&gt;Rust  system&lt;/b&gt;&lt;br&gt;&lt;br&gt;same seed, same ops" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#d9f0dd;strokeColor=#2e8b57;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="670" y="104" width="190" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n21" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="234" y="144" as="sourcePoint"/>
        <mxPoint x="246" y="144" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n22" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="444" y="144" as="sourcePoint"/>
        <mxPoint x="456" y="144" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n23" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="654" y="144" as="sourcePoint"/>
        <mxPoint x="666" y="144" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n31" value="&lt;b&gt;What pairing can cancel&lt;/b&gt;&lt;br&gt;&lt;br&gt;A noisy minute of the host hits all four&lt;br&gt;variants in that block. The paired test then&lt;br&gt;sees the language difference, not the&lt;br&gt;noise. That is why the family is exact&lt;br&gt;permutation tests over 20 pairs." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="40" y="212" width="400" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="n39" value="&lt;b&gt;What pairing cannot cancel&lt;/b&gt;&lt;br&gt;&lt;br&gt;A stall that hits only the high tail of&lt;br&gt;one variant. p99 is computed from exactly&lt;br&gt;those operations. The far tail is pooled&lt;br&gt;across repeats, so it has no across-run&lt;br&gt;interval and stays out of the family." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="460" y="212" width="380" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="n40" value="A load picked after seeing the sweep cannot enter the family. That is why the tracking gap at 448 kops/s is shown and not tested." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="35.75" y="465.07" width="808.51" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="52_three_concurrency_words" name="Three concurrency words">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="560" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="Three words that are not synonyms" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="242.16" y="11.1" width="395.67" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="Taking Rust drops one class of concurrency defect and leaves in place the class that fails in silence." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="92.56" y="42.12" width="694.88" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n15" value="&lt;b&gt;Data race&lt;/b&gt;&lt;br&gt;&lt;br&gt;Two threads, one location,&lt;br&gt;no synchronisation, one write.&lt;br&gt;&lt;br&gt;Safe Rust: compile error&lt;br&gt;(Send / Sync).&lt;br&gt;C++: TSan, if the test hits it.&lt;br&gt;&lt;br&gt;This is inside the guarantee.&lt;br&gt;H2 holds here." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="272" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="n28" value="&lt;b&gt;Race condition&lt;/b&gt;&lt;br&gt;&lt;br&gt;Each access is synced. The&lt;br&gt;composed step is still not atomic.&lt;br&gt;Example: lost update.&lt;br&gt;&lt;br&gt;The borrow checker is silent.&lt;br&gt;TSan is silent. There is no&lt;br&gt;unsynced access to find.&lt;br&gt;&lt;br&gt;Outside the guarantee.&lt;br&gt;H2's looser reading fails here." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="304" y="76" width="272" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="n41" value="&lt;b&gt;Lock-order deadlock&lt;/b&gt;&lt;br&gt;&lt;br&gt;Two threads take two locks&lt;br&gt;in opposite orders and wait.&lt;br&gt;&lt;br&gt;A Mutex guard whose life the&lt;br&gt;borrow checker tracks well&lt;br&gt;says nothing about order.&lt;br&gt;&lt;br&gt;TSan hit 5 of 12 runs.&lt;br&gt;Do not quote that rate from&lt;br&gt;memory. It jumps." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="592" y="76" width="272" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="n42" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#f1f4f7;strokeColor=#d7dde3;strokeWidth=1.5;" vertex="1" parent="1">
      <mxGeometry x="16" y="396" width="848" height="104" as="geometry"/>
    </mxCell>
    <mxCell id="n43" value="A plan that reads memory-safe as concurrency-safe" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="407.65" width="347.17" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n44" value="would mis-budget its review effort. About a third of the non-deadlock" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="428.6" width="451.26" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n45" value="concurrency bugs in Lu's field study broke the order the writers meant," style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="444.6" width="464.34" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n46" value="not their locking. Static deadlock checks for Rust are still open research." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="460.6" width="490.5" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n47" value="Leave the concurrency review budget where it is. That is guideline 3." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="223.77" y="525.08" width="432.46" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="53_checked_by_default" name="Checked by default">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="520" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="One case reached past the fault programs" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="200.2" y="11.1" width="479.6" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="A spec gap let a call be sent outside the service running window. Every test missed it, because nothing ever called that path." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="10.81" y="42.12" width="858.38" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n15" value="&lt;b&gt;1.  Spec gap&lt;/b&gt;&lt;br&gt;&lt;br&gt;A call was legal in the&lt;br&gt;written spec at a time&lt;br&gt;the service was not&lt;br&gt;running.&lt;br&gt;&lt;br&gt;Both versions inherited&lt;br&gt;the hole. The method&lt;br&gt;left each to fail in its&lt;br&gt;own idiom." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f1f4f7;strokeColor=#d7dde3;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="80" width="200" height="220" as="geometry"/>
    </mxCell>
    <mxCell id="n26" value="&lt;b&gt;2.  What missed it&lt;/b&gt;&lt;br&gt;&lt;br&gt;Parity vectors.&lt;br&gt;Generated campaign.&lt;br&gt;ASan, TSan, UBSan.&lt;br&gt;Miri.&lt;br&gt;&lt;br&gt;Nothing called that&lt;br&gt;path, so nothing had&lt;br&gt;a failure to report." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="232" y="80" width="200" height="220" as="geometry"/>
    </mxCell>
    <mxCell id="n37" value="&lt;b&gt;3.  What caught it&lt;/b&gt;&lt;br&gt;&lt;br&gt;A plain bounds check&lt;br&gt;on the Rust side.&lt;br&gt;Undefined behaviour&lt;br&gt;became a catchable&lt;br&gt;failure.&lt;br&gt;&lt;br&gt;Not a proof.&lt;br&gt;Checked by default." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="448" y="80" width="200" height="220" as="geometry"/>
    </mxCell>
    <mxCell id="n48" value="&lt;b&gt;4.  What to plan for&lt;/b&gt;&lt;br&gt;&lt;br&gt;Do not budget as if&lt;br&gt;compile time had ruled&lt;br&gt;the hole out.&lt;br&gt;&lt;br&gt;A ban stated without a&lt;br&gt;way behind it leaves&lt;br&gt;each version to fail in&lt;br&gt;its own idiom." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="664" y="80" width="200" height="220" as="geometry"/>
    </mxCell>
    <mxCell id="n49" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="220" y="190" as="sourcePoint"/>
        <mxPoint x="228" y="190" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n50" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="436" y="190" as="sourcePoint"/>
        <mxPoint x="444" y="190" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n51" value="" style="html=1;rounded=0;strokeColor=#2f6db3;strokeWidth=2.0;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="652" y="190" as="sourcePoint"/>
        <mxPoint x="660" y="190" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n52" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="16" y="324" width="848" height="128" as="geometry"/>
    </mxCell>
    <mxCell id="n53" value="The root cause belongs to the method" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#8c2a20;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="335.65" width="255.06" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n54" value="Parity bounds the paths the suite drives. A clean sanitiser result is bounded by the code that actually ran." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="360.12" width="735.75" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n55" value="RQ2's injected catalogue is still final for the fourteen programs. This case is why the thesis also talks about checked-by-default," style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="378.12" width="892.44" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n56" value="not only ruled-out-at-compile-time." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="396.12" width="238.44" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n57" value="Chapter 6, after the guarantee-boundary figure. It is part of the answer to RQ2, not a footnote." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="139.16" y="485.07" width="601.68" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="54_testbed_protocol" name="Testbed protocol">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="560" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="What the measurement host does, and what it refuses" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="134.25" y="11.1" width="611.49" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="One socket, AMD EPYC 7443. The program runs on the machine itself, not inside a virtual machine." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="113.0" y="42.12" width="654.0" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n8" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="420" height="320" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="DONE" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#2e8b57;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="420" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n12" value="SMT off. One thread per core." style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d7bb;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f6b41;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="126" width="380" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n15" value="Governor performance. Boost off." style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d7bb;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f6b41;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="160" width="380" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n18" value="nohz_full on the pinned cores." style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d7bb;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f6b41;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="194" width="380" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n21" value="16 pinned cores, 2 to 17." style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d7bb;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f6b41;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="228" width="380" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n24" value="Clock held fixed." style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d7bb;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f6b41;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="262" width="380" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n27" value="Rocky image pins gcc-toolset major." style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d7bb;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f6b41;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="296" width="380" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n30" value="g++ 15.2.1, rustc 1.97.1." style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d7bb;align=center;verticalAlign=middle;fontSize=12;fontColor=#1f6b41;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="330" width="380" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n35" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="452" y="76" width="412" height="320" as="geometry"/>
    </mxCell>
    <mxCell id="n36" value="REFUSED" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#a5281b;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="452" y="76" width="412" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n43" value="&lt;b&gt;isolcpus&lt;/b&gt;&lt;br&gt;&lt;br&gt;It also stops the kernel sharing work&lt;br&gt;across the allowed cores. Each test&lt;br&gt;thread then lands on one core. An&lt;br&gt;earlier campaign ran that way. Void." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="126" width="376" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="n51" value="&lt;b&gt;A derived representative load&lt;/b&gt;&lt;br&gt;&lt;br&gt;The old rule took the busiest load&lt;br&gt;holding p99 under 5 ms. On the guest&lt;br&gt;that was the host noise floor. On a&lt;br&gt;quiet host it climbs to the knee.&lt;br&gt;ReprLoad is pinned at 56 kops/s." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#ffffff;strokeColor=#e6b3ad;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="470" y="240" width="376" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="n52" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="16" y="416" width="848" height="84" as="geometry"/>
    </mxCell>
    <mxCell id="n53" value="The image still uses the kernel of the host it sits on" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#a5700c;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="427.65" width="382.59" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n54" value="So the guest sweep and the reported sweep differ in hardware, kernel," style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="448.6" width="451.26" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n55" value="and one GCC 15 point release. Do not write that they share a toolchain." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="464.6" width="464.34" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n56" value="bench/TESTBED.md is scripted and published. Executing the protocol and rerunning the same scripts is the only step between hosts." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="35.75" y="525.08" width="808.51" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="55_list_vs_built" name="List versus programs">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="520" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="A list of bug types is not a program that was built" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="134.25" y="11.1" width="611.49" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="Meneely mapped CWE types onto what safe Rust would stop. This thesis asks the same question of programs that compile and run." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="14.22" y="42.12" width="851.56" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n18" value="&lt;b&gt;Prior estimate (a list)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Take the Common Weakness Enumeration.&lt;br&gt;Mark each type as one safe Rust would&lt;br&gt;stop, or would not.&lt;br&gt;Count real product bugs in 68 open-&lt;br&gt;source C projects.&lt;br&gt;&lt;br&gt;58.2% sat in types that safe Rust would&lt;br&gt;have made almost impossible.&lt;br&gt;&lt;br&gt;That share is a best case. It assumes&lt;br&gt;the new code stays in safe Rust. A type&lt;br&gt;counts as stopped if the mapping says so." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=6;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="80" width="400" height="280" as="geometry"/>
    </mxCell>
    <mxCell id="n32" value="&lt;b&gt;This thesis (programs)&lt;/b&gt;&lt;br&gt;&lt;br&gt;14 small programs, two groups of seven.&lt;br&gt;Each expectation recorded before the run.&lt;br&gt;C++ built and run under three sanitisers.&lt;br&gt;Safe Rust compiled, and run if it builds.&lt;br&gt;&lt;br&gt;The study can then say when the types&lt;br&gt;still open are caught, and what it costs&lt;br&gt;to catch them.&lt;br&gt;&lt;br&gt;That is why RQ2 is two-sided. A one-sided&lt;br&gt;catalogue can only confirm the guarantee." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=6;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="448" y="80" width="416" height="280" as="geometry"/>
    </mxCell>
    <mxCell id="n33" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="16" y="380" width="848" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n34" value="What this adds" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="391.65" width="99.19" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n35" value="Not a larger percentage. A stage and a cost for each class that still compiles: sanitiser, model checker after a rewrite, or undetected." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="416.12" width="926.5" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n36" value="Chapter 1, after the hypotheses. The 58.2% figure is theirs. Do not treat it as a result of this study." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="117.22" y="485.07" width="645.55" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="56_one_address_space" name="One address space">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="520" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="Keeping unsafe at the seam bounds review, not corruption" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="104.28" y="11.1" width="671.44" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="Host and part share one address space. A compile-time property of the Rust core bounds nothing at run time once a pointer has crossed." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="-16.44" y="42.12" width="912.88" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n8" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="260" height="250" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="C++ HOST" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="260" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n12" value="opaque handle" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dce8f7;strokeColor=#bcd0e8;align=center;verticalAlign=middle;fontSize=13;fontColor=#1c4e86;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="128" width="220" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n15" value="status codes only" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dce8f7;strokeColor=#bcd0e8;align=center;verticalAlign=middle;fontSize=13;fontColor=#1c4e86;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="176" width="220" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n18" value="same process" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dce8f7;strokeColor=#bcd0e8;align=center;verticalAlign=middle;fontSize=13;fontColor=#1c4e86;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="224" width="220" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n23" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#fff3ec;strokeColor=#d35400;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="310" y="76" width="260" height="250" as="geometry"/>
    </mxCell>
    <mxCell id="n24" value="SEAM  (unsafe lives here)" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#a04000;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="310" y="76" width="260" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n27" value="11 C entry points" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0975a;align=center;verticalAlign=middle;fontSize=13;fontColor=#a04000;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="330" y="128" width="220" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n30" value="9 unsafe functions" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0975a;align=center;verticalAlign=middle;fontSize=13;fontColor=#a04000;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="330" y="176" width="220" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n33" value="231 lines of Rust" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e0975a;align=center;verticalAlign=middle;fontSize=13;fontColor=#a04000;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="330" y="224" width="220" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n38" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=2.0;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="604" y="76" width="260" height="250" as="geometry"/>
    </mxCell>
    <mxCell id="n39" value="RUST CORE" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#2e8b57;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="604" y="76" width="260" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n42" value="0 unsafe sites" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d9f0dd;strokeColor=#a8d7bb;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f6b41;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="624" y="128" width="220" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n45" value="unchanged by the host" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d9f0dd;strokeColor=#a8d7bb;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f6b41;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="624" y="176" width="220" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n48" value="Send / Sync still apply" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d9f0dd;strokeColor=#a8d7bb;align=center;verticalAlign=middle;fontSize=13;fontColor=#1f6b41;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="624" y="224" width="220" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="n49" value="" style="html=1;rounded=0;strokeColor=#a5281b;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="280" y="200" as="sourcePoint"/>
        <mxPoint x="306" y="200" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n50" value="" style="html=1;rounded=0;strokeColor=#a5281b;strokeWidth=2.2;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="574" y="200" as="sourcePoint"/>
        <mxPoint x="600" y="200" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="n51" value="one address space" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#a5281b;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="384.41" y="336.6" width="111.18" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n52" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="16" y="372" width="848" height="88" as="geometry"/>
    </mxCell>
    <mxCell id="n53" value="What a vendor could misread" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#8c2a20;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="383.65" width="191.3" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n54" value="The RQ2 result is not a licence to describe a moved part as safe. The seam double-free is the in-guarantee class returning inside unsafe." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="408.6" width="895.98" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n55" value="Guideline 2 keeps the C ABI in its own crate so unsafe does not spread through crate chains. It does not sandbox the host." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="426.6" width="797.88" height="18.0" as="geometry"/>
    </mxCell>
    <mxCell id="n56" value="Per-call tax bounded at 10.91% of a real signal call. A do-nothing crossing bounds only itself." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="142.29" y="485.07" width="595.41" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="57_findings_one_page" name="Findings one page">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="560" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="What each research question returned" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="224.18" y="11.1" width="431.64" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="The answer to RQ1 splits at saturation. RQ2 is final. RQ3 splits by resource. RQ4 is cheap in the machine." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="78.94" y="42.12" width="722.13" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n12" value="&lt;b&gt;RQ1  Latency&lt;/b&gt;&lt;br&gt;&lt;br&gt;Below saturation: medians within 1.6 us.&lt;br&gt;Paired gap 1.3 us. Too small to bound.&lt;br&gt;Far tail: Rust lower by 50 us, pooled.&lt;br&gt;Rust tracks to 448 kops/s, C++ to 392.&lt;br&gt;At 784 kops/s, C++ finishes 1.7x as much.&lt;br&gt;Those two picks point at opposite sides." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="76" width="416" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="n21" value="&lt;b&gt;RQ2  Defects&lt;/b&gt;&lt;br&gt;&lt;br&gt;All 7 in-guarantee classes: compile error.&lt;br&gt;All 7 boundary classes: compile and fail.&lt;br&gt;On two of them C++ tools flag what Rust's do not.&lt;br&gt;Rust drops data races and aliasing errors.&lt;br&gt;It does not drop race conditions, lock order,&lt;br&gt;leaks, wrapping, or a failed worker's blast." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="448" y="76" width="416" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="n29" value="&lt;b&gt;RQ3  Resources&lt;/b&gt;&lt;br&gt;&lt;br&gt;Language RSS 1.4 to 2.5 MiB, all hosts.&lt;br&gt;Allocator 1.5 to 2.4 MiB, either language.&lt;br&gt;Comparable on bare metal. Guest ratio does not travel.&lt;br&gt;CPU at 56 kops/s: Rust at most 5.1 pp less.&lt;br&gt;CPU past saturation: sign flips. Do not mix the two." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="292" width="416" height="176" as="geometry"/>
    </mxCell>
    <mxCell id="n37" value="&lt;b&gt;RQ4  Adoption&lt;/b&gt;&lt;br&gt;&lt;br&gt;Seam: 11 entries, 9 unsafe functions.&lt;br&gt;Per-call bound 10.91% of a real signal.&lt;br&gt;54% of the Rust build is crates.&lt;br&gt;Size gap is a linkage policy. Order flips if matched.&lt;br&gt;C++ leads the single-file edit and compile loop." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fff3ec;strokeColor=#d35400;strokeWidth=1.7;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="448" y="292" width="416" height="176" as="geometry"/>
    </mxCell>
    <mxCell id="n38" value="Taken as a set these support a narrow claim, for stateful, concurrent, partitionable control-plane services of this kind." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="60.82" y="525.08" width="758.37" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="58_instrument_not_verdict" name="Instrument, not verdict">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="500" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="What the thesis adds is an instrument, not a verdict" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="128.26" y="11.1" width="623.48" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="At loads where the service still meets its sent rate, the choice is which defects a team will make impossible to write." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="34.66" y="42.12" width="810.69" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n5" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="26" y="84" width="28" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n9" value="&lt;b&gt;Frozen spec&lt;/b&gt;&lt;br&gt;&lt;br&gt;The main control against writer bias. Public. Both sides follow it." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="64" y="80" width="796" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n11" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="26" y="140" width="28" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n15" value="&lt;b&gt;Parity-tested pair&lt;/b&gt;&lt;br&gt;&lt;br&gt;Same paths, same seeds, a Python oracle, sanitisers on the path taken." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="64" y="136" width="796" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n17" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="26" y="196" width="28" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n21" value="&lt;b&gt;Harness past the knee&lt;/b&gt;&lt;br&gt;&lt;br&gt;Open-loop, interleaved, Holm family fixed before the campaign." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="64" y="192" width="796" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n23" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="26" y="252" width="28" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n27" value="&lt;b&gt;A split of the round-trip&lt;/b&gt;&lt;br&gt;&lt;br&gt;Says how much of what it times the language can own." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="64" y="248" width="796" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n29" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="26" y="308" width="28" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n33" value="&lt;b&gt;A defect catalogue&lt;/b&gt;&lt;br&gt;&lt;br&gt;Maps where the guarantee stops, with a stage and a cost." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="64" y="304" width="796" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n35" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2f6db3;strokeColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="26" y="364" width="28" height="28" as="geometry"/>
    </mxCell>
    <mxCell id="n39" value="&lt;b&gt;A thin C-ABI seam&lt;/b&gt;&lt;br&gt;&lt;br&gt;Shows a C++ host can drive an unchanged Rust core." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#bcd0e8;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="64" y="360" width="796" height="48" as="geometry"/>
    </mxCell>
    <mxCell id="n40" value="Past the knee it is a speed choice as well. A nominal-load test would not have exposed the gap." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="142.29" y="465.07" width="595.41" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
  <diagram id="59_guest_could_not_resolve" name="Guest could not resolve">
<mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="520" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="n2" value="The guest could not resolve the far tail. Bare metal can." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=22;fontColor=#12233a;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="98.28" y="11.1" width="683.43" height="33.0" as="geometry"/>
    </mxCell>
    <mxCell id="n3" value="The earlier KVM sweep is kept so host-owned findings have a counter-example sitting beside them." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="113.0" y="42.12" width="654.0" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n15" value="&lt;b&gt;KVM guest&lt;/b&gt;&lt;br&gt;&lt;br&gt;p99 noise on one variant: 1480 us.&lt;br&gt;Gap between all four variants: 293 us.&lt;br&gt;Noise on one variant was larger than the&lt;br&gt;gap between all four. The far tail could&lt;br&gt;not be read.&lt;br&gt;&lt;br&gt;g++ 15.1.1. Same rustc.&lt;br&gt;No core controls. Hypervisor in the way.&lt;br&gt;Kept, not dropped. Same design, same code." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#fdf6e9;strokeColor=#c8860d;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=6;fontSize=13;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="16" y="80" width="416" height="280" as="geometry"/>
    </mxCell>
    <mxCell id="n27" value="&lt;b&gt;Bare metal (reported)&lt;/b&gt;&lt;br&gt;&lt;br&gt;p99 noise on one variant: 0.8 us.&lt;br&gt;Gap between all four variants: 1.6 us.&lt;br&gt;Noise is smaller than the gap. Both p99&lt;br&gt;rows and both p99.9 rows clear Holm,&lt;br&gt;4 rows in all.&lt;br&gt;&lt;br&gt;Far tail pooled, 3,360,051 to 3,360,084 calls.&lt;br&gt;Slowest Rust variant 50 us below fastest C++.&lt;br&gt;A second bare-metal host agrees." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=20;fillColor=#f4fbf6;strokeColor=#2e8b57;strokeWidth=1.8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=6;fontSize=13;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="448" y="80" width="416" height="280" as="geometry"/>
    </mxCell>
    <mxCell id="n28" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=18;fillColor=#eef3fa;strokeColor=#2f6db3;strokeWidth=1.6;" vertex="1" parent="1">
      <mxGeometry x="16" y="380" width="848" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n29" value="What this licences" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1c4e86;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="32" y="391.65" width="127.53" height="19.5" as="geometry"/>
    </mxCell>
    <mxCell id="n30" value="Speed and RSS results name the host. RQ2 and the seam structure do not." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="412.12" width="483.69" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n31" value="Tail delay numbers from any single host are a thinner basis for a roll-out than they look." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="32" y="428.12" width="613.13" height="18.75" as="geometry"/>
    </mxCell>
    <mxCell id="n32" value="That is why the earlier guest sweep is kept, not dropped. Chapter 6, ethical and professional reflection." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="110.96" y="485.07" width="658.09" height="17.25" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
  </diagram>
</mxfile>
