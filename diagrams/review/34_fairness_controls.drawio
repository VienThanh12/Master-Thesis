    <mxCell id="n39" value="LOGGED, NOT RESOLVED" style="rounded=1;absoluteArcSize=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#a5700c;strokeColor=none;align=center;verticalAlign=middle;fontSize=14.5;fontColor=#ffffff;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="462" y="76" width="402" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="n43" value="Bounded queue: Rust sync_channel. C++ mutex and&lt;br&gt;two condition variables." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="126" width="366" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="n47" value="Reply handle: std::promise against a fresh mpsc&lt;br&gt;channel per request." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="170" width="366" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="n51" value="Per-shard map: Each language's own standard hash&lt;br&gt;map." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="214" width="366" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="n55" value="Request encoding: C++ tagged struct 160 B, Rust&lt;br&gt;enum 96 B." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#c8860d;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;spacingRight=6;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="480" y="258" width="366" height="40" as="geometry"/>
