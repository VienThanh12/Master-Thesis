    <mxCell id="n55" value="&lt;b&gt;It calls&lt;/b&gt;&lt;br&gt;&lt;br&gt;plot_figures.py: figures,&lt;br&gt;tables, and gen_macros.tex&lt;br&gt;complexity.py: size and&lt;br&gt;cyclomatic-complexity proxies" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#ffffff;strokeColor=#a8d7bb;strokeWidth=1.0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=6;fontSize=10;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
