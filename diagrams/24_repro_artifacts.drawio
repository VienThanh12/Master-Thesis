    </mxCell>
    <mxCell id="n45" value="logs and rebuilds the PDF, then" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="324" y="186.03" width="177.4" height="15.75" as="geometry"/>
    </mxCell>
    <mxCell id="n46" value="fails loudly if LaTeX reports an" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="324" y="200.03" width="183.12" height="15.75" as="geometry"/>
    </mxCell>
    <mxCell id="n47" value="error or an unresolved reference." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
