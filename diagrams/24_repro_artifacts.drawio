    <mxCell id="n73" value="The environment record (CPU model," style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="598" y="278.02" width="194.56" height="15.75" as="geometry"/>
    </mxCell>
    <mxCell id="n74" value="kernel, and toolchain versions) is" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="598" y="292.02" width="194.56" height="15.75" as="geometry"/>
    </mxCell>
    <mxCell id="n75" value="captured by capture_env.sh and stored" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="598" y="306.02" width="211.73" height="15.75" as="geometry"/>
    </mxCell>
    <mxCell id="n76" value="with each result set, so the conditions of" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="598" y="320.02" width="240.34" height="15.75" as="geometry"/>
    </mxCell>
    <mxCell id="n77" value="a measurement travel with its data." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5b6b7b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="598" y="334.02" width="200.29" height="15.75" as="geometry"/>
    </mxCell>
    <mxCell id="n78" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#fdf1f0;strokeColor=#a5281b;strokeWidth=1.7;" vertex="1" parent="1">
      <mxGeometry x="20" y="406" width="840" height="56" as="geometry"/>
    </mxCell>
    <mxCell id="n79" value="Not required:" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#8c2a20;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="36" y="417.07" width="81.48" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n80" value="no proprietary source. The implementations are driven entirely by the public specification, and the" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="126" y="418.02" width="566.53" height="15.75" as="geometry"/>
    </mxCell>
    <mxCell id="n81" value="subsystem is modelled on production code rather than copied from it." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#33475b;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="36" y="437.02" width="389.13" height="15.75" as="geometry"/>
    </mxCell>
    <mxCell id="n82" value="Separating environment-sensitive results from environment-insensitive ones is what lets the thesis" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="132.89" y="467.07" width="614.22" height="17.25" as="geometry"/>
    </mxCell>
    <mxCell id="n83" value="label the first preliminary and the second final without ambiguity." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11.5;fontColor=#8794a3;fontFamily=Segoe UI;" vertex="1" parent="1">
      <mxGeometry x="230.04" y="483.07" width="419.92" height="17.25" as="geometry"/>
    </mxCell>
